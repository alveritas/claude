# ── Payments: Square (card, Apple Pay, Google Pay, Cash App Pay) ──
# developer.squareup.com → your app → Production → Credentials → Production Access token.
# With a production token set, the store opens for sale by itself on the next deploy.
SQUARE_ACCESS_TOKEN=
# Optional: "sandbox" to test with Square's sandbox token instead of real payments.
SQUARE_ENVIRONMENT=
# Optional: a specific Square location (defaults to your main one).
SQUARE_LOCATION_ID=
# Optional: only if order notifications can't connect by themselves (see Admin → Payments).
SQUARE_WEBHOOK_SIGNATURE_KEY=

# On Vercel you only add two of these yourself: ADMIN_EMAIL and SQUARE_ACCESS_TOKEN.
# The Supabase values are filled in automatically when you add Supabase from the project's
# Storage tab, and the site's address is taken from your Vercel domain.
# On Netlify add ADMIN_EMAIL, SQUARE_ACCESS_TOKEN and DATABASE_URL, plus the three Supabase values
# (or install Netlify's Supabase extension). The address is taken from your Netlify domain.
# For running on your own computer: copy to .env.local and fill in. Never commit real values.

# Your email. Sign up on the site with it (and confirm it) and that account is the admin.
ADMIN_EMAIL=

# Stripe: no longer used (Square takes payments). Only used if SQUARE_ACCESS_TOKEN is empty.
STRIPE_SECRET_KEY=

# Optional on Vercel (your domain is used automatically). Locally: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Supabase — added by Vercel's Supabase integration. Either key style works:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # or NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=                    # or SUPABASE_SERVICE_ROLE_KEY — server only, never in browser code
# Database address used during each build to create/update the tables (scripts/setup-db.mjs).
# Vercel's integration sets POSTGRES_URL_NON_POOLING; elsewhere use Supabase → Connect → Session pooler.
DATABASE_URL=

# Only needed if you set up the Stripe webhook by hand instead of Admin → Payments,
# or for `stripe listen` on your own computer.
STRIPE_WEBHOOK_SECRET=

# Optional: Resend (resend.com) for order and shipping confirmation emails
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g. "NEVERHOLLOW <orders@yourdomain.com>"
EMAIL_FROM=
