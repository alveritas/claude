{%- comment -%} One row in search results and suggestions: photo, name, price. Accepts: product. {%- endcomment -%}
<a class="search-hit" href="{{ product.url }}">
  <span class="frame search-hit-img">
    {%- render 'flat-image', product: product, width: 240, widths: '120, 240', sizes: '64px', alt: '' -%}
  </span>
  <span class="search-hit-name">{{ product.title }}</span>
  <span class="search-hit-price">{{ product.price | money_without_trailing_zeros }}{% if product.price_varies %}+{% endif %}</span>
</a>
