{%- comment -%} Open Graph and Twitter cards. Accepts: brand. {%- endcomment -%}
{%- liquid
  assign brand = brand | default: shop.name
  assign og_title = page_title | default: brand
  if request.page_type == 'index'
    assign og_title = brand | append: ' | ' | append: settings.brand_tagline
  endif
  if settings.lowercase
    assign og_title = og_title | downcase
  endif
  assign og_type = 'website'
  assign og_description = page_description | default: settings.seo_description | default: settings.brand_tagline | strip_html
  if request.page_type == 'product'
    assign og_type = 'product'
  endif
-%}
<meta property="og:site_name" content="{{ brand | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  <meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: page_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ page_image.alt | default: og_title | escape }}">
{%- elsif settings.share_image != blank -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: settings.share_image.aspect_ratio | round }}">
{%- else -%}
  <meta property="og:image" content="https:{{ 'nh-share.jpg' | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="{{ brand | escape }}: {{ settings.brand_tagline | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html | remove: ',' }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
