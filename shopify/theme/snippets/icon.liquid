{%- comment -%} Line icons drawn to match the site: {% render 'icon', name: 'bag' %} {%- endcomment -%}
{%- assign s = size | default: 20 -%}
<svg class="icon icon-{{ name }}" width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="square" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>
    {%- when 'bag' -%}<path d="M5 8.5h14l-1 12H6l-1-12z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>
    {%- when 'user' -%}<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/>
    {%- when 'close' -%}<path d="M5.5 5.5l13 13M18.5 5.5l-13 13"/>
    {%- when 'menu' -%}<path d="M4 8h16M4 16h16"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'minus' -%}<path d="M5 12h14"/>
    {%- when 'chevron-left' -%}<path d="M14.5 6l-6 6 6 6"/>
    {%- when 'chevron-right' -%}<path d="M9.5 6l6 6-6 6"/>
    {%- when 'lock' -%}<rect x="5" y="10.5" width="14" height="10"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/>
    {%- when 'globe' -%}<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.5 2.6 3.6 5.4 3.6 8.5s-1.1 5.9-3.6 8.5c-2.5-2.6-3.6-5.4-3.6-8.5s1.1-5.9 3.6-8.5z"/>
    {%- when 'return' -%}<path d="M9 6.5 5 10.5l4 4"/><path d="M5 10.5h9.5a4.5 4.5 0 0 1 0 9H11"/>
    {%- when 'mail' -%}<rect x="3.5" y="5.5" width="17" height="13"/><path d="M3.5 6.5 12 13l8.5-6.5"/>
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'expand' -%}<path d="M14 4h6v6M10 20H4v-6M20 4l-7 7M4 20l7-7"/>
  {%- endcase -%}
</svg>
