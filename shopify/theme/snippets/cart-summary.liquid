{%- comment -%}
  Accepts: compact (the drawer: the essentials only; the drawer shows the pre-order note with the pieces,
  and the bag page shows it here with the full shipping and returns lines).
{%- endcomment -%}
<div class="cart-summary">
  <dl class="sum">
    <div class="sum-row"><dt>Subtotal</dt><dd class="tabular" data-cart-subtotal>{{ cart.total_price | money_without_trailing_zeros }}</dd></div>
    <div class="sum-row muted"><dt>Shipping</dt><dd>Added at checkout</dd></div>
  </dl>
  {%- if settings.shipping_summary != blank and compact != true -%}<p class="muted micro">{{ settings.shipping_summary | escape }}</p>{%- endif -%}
  {%- assign po_line = '' -%}
  {%- for item in cart.items -%}
    {%- if item.properties['Pre-order'] != blank -%}{%- assign po_line = item.properties['Pre-order'] -%}{%- endif -%}
  {%- endfor -%}
  {%- if compact != true -%}{% render 'bag-preorder-note' %}{%- endif -%}
  <form action="{{ routes.cart_url }}" method="post" class="checkout-form">
    <button type="submit" name="checkout" class="btn btn-solid btn-block">Checkout</button>
  </form>
  <p class="muted micro center">{% render 'icon', name: 'lock', size: 12 %} Secure checkout. Card details never touch this site.</p>
  {%- if settings.returns_note != blank and compact != true -%}
    {%- assign returns_line = settings.returns_note -%}
    {%- if po_line != blank -%}{%- assign returns_line = settings.returns_note | replace: 'All sales are final.', 'All sales are final once your order ships.' | replace: 'All sales are final —', 'All sales are final once your order ships —' -%}{%- endif -%}
    <p class="micro">{{ returns_line | escape }}</p>
  {%- endif -%}
</div>
