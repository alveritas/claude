{%- comment -%}
  Prints the product types among the pieces tagged `tag` (Men or Women), comma separated, e.g.
  "Bottoms,Hoodies,Tops". Reads every piece (not the page's own, possibly filtered, collection), so the
  list is the same on /collections/men and /collections/men/tops. Capture it and split on commas:
  {% capture men_types %}{% render 'gender-types', tag: 'Men' %}{% endcapture %}
{%- endcomment -%}
{%- liquid
  assign out = ''
  for p in collections.all.products
    if p.tags contains tag and p.type != blank
      assign key = ',' | append: p.type | append: ','
      assign probe = ',' | append: out | append: ','
      unless probe contains key
        if out != blank
          assign out = out | append: ','
        endif
        assign out = out | append: p.type
      endunless
    endif
  endfor
  assign sorted = out | split: ',' | sort | join: ','
  echo sorted
-%}
