{%- comment -%} The bag's lines, shared by the drawer and the bag page. {%- endcomment -%}
<ul class="cart-lines">
  {%- for item in cart.items -%}
    <li class="cart-line" data-line-key="{{ item.key }}">
      <a class="frame cart-thumb" href="{{ item.url }}">
        {%- if item.image -%}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', decoding: 'async', alt: item.product.title, sizes: '96px', widths: '120, 240' }}{%- endif -%}
      </a>
      <div class="cart-line-body">
        <div class="cart-line-top">
          <a class="cart-line-title" href="{{ item.url }}">{{ item.product.title }}</a>
          <span class="tabular">{{ item.final_line_price | money_without_trailing_zeros }}</span>
        </div>
        {%- unless item.product.has_only_default_variant -%}
          <p class="muted micro">{% for option in item.options_with_values %}{{ option.name }} {{ option.value }}{% unless forloop.last %} / {% endunless %}{% endfor %}</p>
        {%- endunless -%}
        {%- for p in item.properties -%}
          {%- assign p_first = p.first | slice: 0 -%}
          {%- unless p.last == blank or p_first == '_' -%}
            <p class="micro cart-prop">{{ p.first }}: {{ p.last }}</p>
          {%- endunless -%}
        {%- endfor -%}
        <div class="cart-line-bottom">
          <div class="qty qty--sm">
            <button type="button" data-line-qty="{{ item.quantity | minus: 1 }}" aria-label="Decrease quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'minus', size: 12 %}</button>
            <span class="qty-value" aria-live="polite">{{ item.quantity }}</span>
            <button type="button" data-line-qty="{{ item.quantity | plus: 1 }}" aria-label="Increase quantity of {{ item.product.title | escape }}">{% render 'icon', name: 'plus', size: 12 %}</button>
          </div>
          <button type="button" class="text-link muted micro" data-line-qty="0">Remove</button>
        </div>
      </div>
    </li>
  {%- endfor -%}
</ul>
