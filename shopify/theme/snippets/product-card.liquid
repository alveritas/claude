{%- comment -%}
  One card per piece: photo (the worn photo shows on hover), then name and price, then a colour line
  that is the same height on every card. The whole card is one link.
  Accepts: product, feature (large first tile), sizes, eager (load the first photo straight away),
  index (position in the grid, staggers the reveal), heading (h2 where the card sits right under the page title; h3 by default).
{%- endcomment -%}
{%- liquid
  assign sizes = sizes | default: '(min-width: 1024px) 25vw, 50vw'
  assign loading = 'lazy'
  if eager
    assign loading = 'eager'
  endif

  assign color_option = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_option = option
    endif
  endfor

  assign first_media = product.featured_media
  if feature
    for m in product.media
      assign alt_down = m.alt | downcase
      if alt_down contains 'worn' or alt_down contains 'model'
        assign first_media = m
        break
      endif
    endfor
  endif
  assign second_media = nil
  for m in product.media
    if m.id != first_media.id
      assign second_media = m
      break
    endif
  endfor

  assign po_tag = false
  if product.available and settings.preorder_enabled and settings.preorder_tag != blank and product.tags contains settings.preorder_tag
    assign po_tag = true
    if settings.preorder_close != blank
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_tag = false
      endif
    endif
  endif
-%}
<article class="card{% if feature %} card--feature{% endif %}">
  <a class="card-link" href="{{ product.url }}">
    <div class="card-frame frame" data-reveal data-cursor="View"{% if index %} style="--d: {{ index | modulo: 4 | times: 0.08 }}s"{% endif %}>
      {%- if first_media -%}
        {{ first_media.preview_image | image_url: width: 1400 | image_tag: widths: '360, 540, 720, 900, 1200, 1400', sizes: sizes, loading: loading, decoding: 'async', alt: first_media.alt, class: 'card-img card-img--main' }}
        {%- if second_media -%}
          {{ second_media.preview_image | image_url: width: 1200 | image_tag: widths: '360, 540, 720, 900, 1200', sizes: sizes, loading: 'lazy', decoding: 'async', alt: '', class: 'card-img card-img--alt' }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
      {%- unless product.available -%}
        <span class="tag">Sold out</span>
      {%- endunless -%}
      {%- if po_tag -%}
        <span class="tag">Pre-order</span>
      {%- endif -%}
    </div>
    <div class="card-body">
      {%- assign hl = heading | default: 'h3' -%}
      <{{ hl }} class="card-title">{{ product.title }}</{{ hl }}>
      <p class="card-price">{{ product.price | money_without_trailing_zeros }}{% if product.price_varies %}+{% endif %}</p>
      {%- if color_option -%}
        <p class="card-meta">
          <span class="card-dots" aria-hidden="true">
            {%- for value in color_option.values -%}<span class="dot" style="--dot: {% render 'swatch', color: value %}"></span>{%- endfor -%}
          </span>
          <span class="card-color">{{ color_option.values | join: ' / ' }}</span>
        </p>
      {%- endif -%}
    </div>
  </a>
</article>
