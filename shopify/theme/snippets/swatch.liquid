{%- comment -%}
  The dot colour for a colourway name. Brand names (Obsidian, Bone, Ash, Fawn) map to their shades;
  anything else falls back to Shopify's own colour name handling.
{%- endcomment -%}
{%- assign c = color | downcase -%}
{%- case c -%}
  {%- when 'obsidian', 'black', 'onyx', 'noir', 'jet', 'ink' -%}#111111
  {%- when 'bone', 'white', 'ivory', 'chalk', 'pearl', 'cream', 'ecru' -%}#ffffff
  {%- when 'fawn' -%}linear-gradient(135deg, #111111 0 50%, #8a6a4f 50% 100%)
  {%- when 'brown', 'mocha', 'cocoa', 'chocolate', 'espresso', 'bark' -%}#5b4232
  {%- when 'ash' -%}#3d3d3d
  {%- when 'grey', 'gray', 'smoke', 'fog', 'mist', 'silver' -%}#9a9893
  {%- when 'charcoal', 'graphite', 'slate', 'coal' -%}#3b3b3a
  {%- when 'sand', 'oat', 'stone', 'dune', 'tan', 'camel', 'khaki', 'taupe' -%}#c9b99d
  {%- when 'navy', 'midnight', 'indigo' -%}#1f2a44
  {%- when 'olive', 'moss', 'sage', 'forest', 'green' -%}#4f5a3c
  {%- when 'red', 'burgundy', 'wine', 'oxblood', 'rust', 'clay' -%}#6e2a26
  {%- else -%}{{ c }}
{%- endcase -%}
