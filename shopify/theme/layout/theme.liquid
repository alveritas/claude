<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {%- liquid
      assign brand = settings.brand_name | default: shop.name
      assign tpl = template | split: '.' | first
    -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#ffffff">
    <meta name="color-scheme" content="only light">
    <script>
      // Motion only runs with the theme script; if it hasn't started within 4s, show everything as is.
      document.documentElement.classList.add("js");
      setTimeout(function () { if (!window.NH_READY) document.documentElement.classList.remove("js"); }, 4000);
    </script>
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if tpl == 'search' or tpl == '404' or template contains 'customers/' or tpl == 'cart' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- else -%}
      <link rel="icon" type="image/png" sizes="96x96" href="{{ 'nh-favicon-96.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'nh-touch-icon.png' | asset_url }}">

    {%- capture seo_title -%}
      {%- if request.page_type == 'index' -%}
        {{ brand }} | {{ settings.brand_tagline }}
      {%- else -%}
        {{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %} | {{ brand }}
      {%- endif -%}
    {%- endcapture -%}
    <title>{{ seo_title | strip }}</title>
    <meta name="description" content="{{ page_description | default: settings.seo_description | strip_html | escape }}">
    {% render 'meta-tags', brand: brand %}

    {%- comment -%}
      Archivo is served from the store itself, trimmed to the widths (62–100%) and weights (400–900)
      the site uses, so the first screen never waits on a third-party font server.
    {%- endcomment -%}
    <link rel="preload" href="{{ 'archivo-nh.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'nh-logo.svg' | asset_url }}" as="image" type="image/svg+xml">
    {%- if request.page_type == 'index' -%}
      <link rel="preload" as="image" href="{{ 'hero-cover-1300.webp' | asset_url }}" imagesrcset="{{ 'hero-cover-900.webp' | asset_url }} 900w, {{ 'hero-cover-1300.webp' | asset_url }} 1300w, {{ 'hero-cover-1800.webp' | asset_url }} 1800w" imagesizes="(min-width: 1024px) min(56vw, 960px), 100vw" fetchpriority="high">
    {%- endif -%}
    <style>
      @font-face {
        font-family: Archivo;
        src: url("{{ 'archivo-nh.woff2' | asset_url }}") format("woff2");
        font-weight: 400 900;
        font-stretch: 62% 100%;
        font-style: normal;
        font-display: swap;
      }
      :root { --mark-wordmark: url("{{ 'nh-logo.svg' | asset_url }}"); }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script>
      window.NH = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          root: {{ routes.root_url | json }}
        },
        moneyFormat: {{ shop.money_format | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ request.page_type | handle }}">
    <a class="skip-link" href="#main">Skip to content</a>
    {% section 'announcement-bar' %}
    {% section 'header' %}

    <main id="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}
    {% section 'cart-drawer' %}
    <p class="sr-only" aria-live="polite" data-announcer></p>

    {%- if request.page_type == 'index' -%}
      {%- liquid
        assign same_as = ''
        if settings.instagram_url != blank
          assign same_as = settings.instagram_url | json
        endif
        if settings.tiktok_url != blank
          if same_as != blank
            assign same_as = same_as | append: ','
          endif
          assign same_as = same_as | append: settings.tiktok_url | json
        endif
        assign origin = request.origin
      -%}
      {%- comment -%} Built with capture: Shopify's parser ends an output tag at the first closing brace, even inside quotes. {%- endcomment -%}
      {%- capture search_target -%}{{ origin }}{{ routes.search_url }}?type=product&q={search_term_string}{%- endcapture -%}
      <script type="application/ld+json">
        [
          {
            "@context": "https://schema.org",
            "@type": "Organization",
            "name": {{ brand | json }},
            "url": {{ origin | append: routes.root_url | json }},
            "logo": {{ 'nh-touch-icon.png' | asset_url | prepend: 'https:' | json }}{% if settings.contact_email != blank %},
            "email": {{ settings.contact_email | json }}{% endif %}{% if same_as != blank %},
            "sameAs": [{{ same_as }}]{% endif %}
          },
          {
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": {{ brand | json }},
            "url": {{ origin | append: routes.root_url | json }},
            "potentialAction": {
              "@type": "SearchAction",
              "target": {{ search_target | json }},
              "query-input": "required name=search_term_string"
            }
          }
        ]
      </script>
    {%- endif -%}
  </body>
</html>
