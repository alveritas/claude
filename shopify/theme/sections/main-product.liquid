{%- liquid
  assign current = product.selected_or_first_available_variant
  assign color_index = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_index = forloop.index0
    endif
  endfor
  assign single_default = false
  if product.has_only_default_variant
    assign single_default = true
  endif

  # Pre-orders: pieces with the pre-order tag say Pre-order, show the ship-by date, and stop
  # selling by themselves after the last pre-order day (Theme settings → Pre-orders).
  assign po = false
  assign po_closed = false
  assign po_ship = ''
  assign po_close_text = ''
  if settings.preorder_enabled and settings.preorder_tag != blank and product.tags contains settings.preorder_tag
    assign po = true
    if settings.preorder_ship != blank
      assign po_ship = settings.preorder_ship | append: 'T12:00:00' | date: '%B %-d, %Y'
    endif
    if settings.preorder_close != blank
      assign po_close_text = settings.preorder_close | append: 'T12:00:00' | date: '%B %-d, %Y'
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_closed = true
      endif
    endif
  endif
  assign add_label = 'Add to bag'
  assign avail_text = 'Available'
  if po
    assign add_label = 'Pre-order'
    assign avail_text = 'Pre-order'
  endif
  # On pre-order pieces, "final" applies once the order ships (pre-orders can be refunded before then).
  assign returns_line = settings.returns_note
  if po
    assign returns_line = settings.returns_note | replace: 'All sales are final.', 'All sales are final once your order ships.' | replace: 'All sales are final —', 'All sales are final once your order ships —'
  endif
  assign can_buy = current.available
  if po_closed
    assign can_buy = false
  endif
-%}
<section class="product-page" data-product-section data-section-id="{{ section.id }}">
  <div class="shell">
    <nav aria-label="Breadcrumb" class="breadcrumb muted">
      <ol>
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        {%- liquid
          assign crumb_g = ''
          if product.tags contains 'Men'
            assign crumb_g = 'Men'
          elsif product.tags contains 'Women'
            assign crumb_g = 'Women'
          endif
          assign crumb_g_handle = crumb_g | downcase
          assign crumb_g_url = collections[crumb_g_handle].url
          if collections[crumb_g_handle].products_count == 0 or crumb_g_url == blank
            assign crumb_g = ''
          endif
        -%}
        {%- if crumb_g != blank -%}
          <li aria-hidden="true">/</li>
          <li><a href="{{ crumb_g_url }}">{{ crumb_g }}</a></li>
        {%- endif -%}
        {%- if product.type != blank -%}
          <li aria-hidden="true">/</li>
          <li><a href="{% if crumb_g != blank %}{{ crumb_g_url }}/{{ product.type | handle }}{% else %}{{ product.type | url_for_type }}{% endif %}">{{ product.type }}</a></li>
        {%- endif -%}
        <li aria-hidden="true">/</li>
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>
  </div>

  <div class="shell product-grid">
    {%- comment -%} Gallery: every photo; with colours, only the chosen colour's photos show. {%- endcomment -%}
    <div class="gallery" data-gallery>
      <div class="gallery-track" data-gallery-track tabindex="0" aria-label="Product photos">
        {%- for media in product.media -%}
          <figure class="gallery-slide frame" data-media-id="{{ media.id }}"{% if forloop.first %} style="view-transition-name: nh-product"{% endif %}>
            <button type="button" class="gallery-zoom" data-zoom aria-label="Open photo {{ forloop.index }} full screen">
              {%- if forloop.first -%}
                {{ media.preview_image | image_url: width: 1800 | image_tag: widths: '540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 768px) 54vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: media.alt, class: 'gallery-img' }}
              {%- else -%}
                {{ media.preview_image | image_url: width: 1800 | image_tag: widths: '540, 720, 900, 1200, 1500, 1800', sizes: '(min-width: 768px) 27vw, 100vw', loading: 'lazy', decoding: 'async', alt: media.alt, class: 'gallery-img' }}
              {%- endif -%}
            </button>
          </figure>
          {%- if forloop.first -%}
            {%- comment -%}
              Arriving from a product card, the card's photo (already loaded) sits behind this one, so the
              photo that travels across from the card lands on a picture rather than an empty frame.
            {%- endcomment -%}
            <script>
              (function () {
                try {
                  var t = JSON.parse(sessionStorage.getItem("nh-trail") || "null"), slide = document.currentScript.previousElementSibling;
                  sessionStorage.removeItem("nh-trail");
                  if (t && t.src && t.path && t.path.split("/").pop() === location.pathname.split("/").pop()) {
                    slide.style.setProperty("--trail", "url(" + JSON.stringify(t.src) + ")");
                    slide.classList.add("has-trail");
                  }
                } catch (e) {}
              })();
            </script>
          {%- endif -%}
        {%- else -%}
          <figure class="gallery-slide frame">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}</figure>
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="gallery-bar">
          <span class="muted small" data-gallery-count>1 / {{ product.media.size }}</span>
          <div class="gallery-arrows">
            <button type="button" class="icon-btn" data-gallery-prev aria-label="Previous photo">{% render 'icon', name: 'chevron-left' %}</button>
            <button type="button" class="icon-btn" data-gallery-next aria-label="Next photo">{% render 'icon', name: 'chevron-right' %}</button>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      <h1 class="page-title">{{ product.title }}</h1>
      <div class="price-row">
        <span class="price" data-price>{{ current.price | money_without_trailing_zeros }}</span>
        {%- if current.compare_at_price > current.price -%}
          <s class="muted" data-compare>{{ current.compare_at_price | money_without_trailing_zeros }}</s>
        {%- endif -%}
        <span class="muted small" data-availability{% if po_closed == false and current.available %} hidden{% endif %}>{% if po_closed %}Pre-orders closed{% elsif current.available %}{{ avail_text }}{% else %}Sold out{% endif %}</span>
      </div>

      {%- if po -%}
        <div class="preorder-note">
          {%- if po_closed -%}
            <p class="preorder-title">Pre-orders closed</p>
            <p class="preorder-text">Pre-orders for this piece closed on {{ po_close_text }}. Join the list at the bottom of the page to hear when it’s back.</p>
          {%- else -%}
            <p class="preorder-title">Pre-order</p>
            {%- if po_ship != blank -%}
              <dl class="preorder-dates">
                {%- if po_close_text != blank -%}<div><dt>Pre-order until</dt><dd>{{ po_close_text }}</dd></div>{%- endif -%}
                <div><dt>Ships by</dt><dd>{{ po_ship }}</dd></div>
              </dl>
            {%- endif -%}
            <p class="preorder-text">Made in one production run once pre-orders close. You pay now. If the run doesn’t go ahead, or it can’t ship by that date, you can have a full refund. Photos show the design, so the finished piece may differ slightly.</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- form 'product', product, id: 'product-form', class: 'product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-input>
        {%- if po and po_closed == false and po_ship != blank -%}
          <input type="hidden" name="properties[Pre-order]" value="Ships by {{ po_ship }}">
        {%- endif -%}

        {%- unless single_default -%}
          {%- for option in product.options_with_values -%}
            {%- assign is_color = false -%}
            {%- if forloop.index0 == color_index -%}{%- assign is_color = true -%}{%- endif -%}
            {%- if is_color and option.values.size == 1 -%}
              <p class="option-single"><span class="label">{{ option.name }}</span> <span class="dot" style="--dot: {% render 'swatch', color: option.values.first %}" aria-hidden="true"></span> {{ option.values.first }}</p>
            {%- else -%}
              <div class="option" data-option="{{ forloop.index0 }}">
                <div class="option-head">
                  <p class="label">{{ option.name }}<span class="option-chosen"> · <span data-option-value="{{ forloop.index0 }}">{{ option.selected_value }}</span></span></p>
                  {%- unless is_color -%}
                    {%- if product.metafields.custom.size_guide != blank -%}
                      <a href="#size-fit" class="text-link micro" data-open-size>Size guide</a>
                    {%- endif -%}
                  {%- endunless -%}
                </div>
                {%- assign cols = option.values.size -%}
                {%- if cols > 6 -%}{%- assign cols = 6 -%}{%- endif -%}
                <div class="option-values{% if is_color %} option-values--color{% endif %}" role="radiogroup" aria-label="{{ option.name }}" style="--n: {{ cols }}">
                  {%- for value in option.values -%}
                    {%- if is_color -%}
                      <button type="button" class="opt opt--color" role="radio" data-value="{{ value | escape }}" aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}">
                        <span class="dot" style="--dot: {% render 'swatch', color: value %}" aria-hidden="true"></span>{{ value }}
                      </button>
                    {%- else -%}
                      <button type="button" class="opt" role="radio" data-value="{{ value | escape }}" aria-checked="{% if option.selected_value == value %}true{% else %}false{% endif %}">{{ value }}</button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endunless -%}

        <div class="buy" data-buy>
          <div class="buy-row">
            {%- unless po_closed -%}
            <div class="qty" data-qty>
              <button type="button" data-qty-minus aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 14 %}</button>
              <input type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" aria-label="Quantity">
              <button type="button" data-qty-plus aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 14 %}</button>
            </div>
            {%- endunless -%}
            <button type="submit" name="add" class="btn btn-solid btn-block" data-add {% unless can_buy %}disabled{% endunless %}>
              <span data-add-label>{% if po_closed %}Pre-orders closed{% elsif current.available %}{{ add_label }}{% else %}Sold out{% endif %}</span>
              <span class="btn-price" data-add-price>{{ current.price | money_without_trailing_zeros }}</span>
            </button>
          </div>
          <div class="dynamic-checkout" data-dynamic-checkout {% unless can_buy %}hidden{% endunless %}>
            {{ form | payment_button }}
          </div>
          <p class="form-error" role="alert" data-form-error hidden></p>
        </div>
      {%- endform -%}

      {%- comment -%}
        Back-in-stock: the request reaches the store as a contact message with the piece and size.
      {%- endcomment -%}
      <div class="restock" data-restock {% if current.available or po_closed %}hidden{% endif %}>
        {%- form 'contact', id: 'restock-form', class: 'restock-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="note" role="status">Done. We’ll email you when it’s back.</p>
          {%- else -%}
            <input type="hidden" name="contact[subject]" value="Back-in-stock request">
            <input type="hidden" name="contact[Piece]" value="{{ product.title | escape }}">
            <input type="hidden" name="contact[Option]" value="{{ current.title | escape }}" data-restock-option>
            <label class="small" for="restock-email"><span data-restock-label>{{ current.title }}</span> is sold out. Leave your email and we’ll let you know when it’s back.</label>
            <div class="restock-row">
              <input id="restock-email" class="boxed" type="email" name="contact[email]" autocomplete="email" placeholder="Email address" required>
              <button type="submit" class="btn btn-solid">Notify me</button>
            </div>
            {%- if form.errors -%}<p class="form-error" role="alert">Enter a valid email address.</p>{%- endif -%}
            <p class="muted micro">One email when it’s restocked. You won’t be added to the newsletter.</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      {%- comment -%} The work order: what you're buying into, label left, value right. {%- endcomment -%}
      <dl class="spec">
        {%- if settings.shipping_summary != blank -%}
          <div><dt>Shipping</dt><dd>{{ settings.shipping_summary | escape }}{% if settings.processing_time != blank %} {{ settings.processing_time | escape }}{% endif %}{% if shop.shipping_policy.url != blank %} <a class="text-link" href="{{ shop.shipping_policy.url }}">Shipping policy</a>{% endif %}</dd></div>
        {%- endif -%}
        {%- if settings.returns_note != blank -%}
          <div><dt>Returns</dt><dd>{{ returns_line | escape }}{% if shop.refund_policy.url != blank %} <a class="text-link" href="{{ shop.refund_policy.url }}">Refund policy</a>{% endif %}</dd></div>
        {%- endif -%}
        <div><dt>Payment</dt><dd>Secure checkout. Card details never reach this site.{% if shop.enabled_payment_types.size > 0 %} <span class="trust-pay" aria-label="Ways to pay">{% for type in shop.enabled_payment_types limit: 6 %}{{ type | payment_type_svg_tag: class: 'pay-icon pay-icon--sm' }}{% endfor %}</span>{% endif %}</dd></div>
        {%- if settings.contact_email != blank -%}
          <div><dt>Questions</dt><dd><a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></dd></div>
        {%- endif -%}
      </dl>

      <div class="accordions">
        <details class="acc" open>
          <summary>Details {% render 'icon', name: 'plus', size: 14 %}</summary>
          <div class="acc-body rte">
            {{ product.description }}
            {%- if product.metafields.custom.fabric != blank -%}<p>{{ product.metafields.custom.fabric }}</p>{%- endif -%}
            {%- if product.metafields.custom.care != blank -%}<p>{{ product.metafields.custom.care }}</p>{%- endif -%}
            {%- if product.metafields.custom.fabric == blank and settings.contact_email != blank -%}
              <p class="muted">Questions about fabric or care? Email <a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a> and we’ll answer before you order.</p>
            {%- endif -%}
          </div>
        </details>
        <details class="acc" id="size-fit">
          <summary>Size &amp; fit {% render 'icon', name: 'plus', size: 14 %}</summary>
          <div class="acc-body rte">
            {%- if product.metafields.custom.size_guide != blank -%}
              {{ product.metafields.custom.size_guide | metafield_tag }}
            {%- else -%}
              <p class="muted">{% if product.tags contains 'Women' %}Women’s sizing.{% else %}Unisex sizing.{% endif %} Not sure which size to get?{% if settings.contact_email != blank %} Email <a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a> with your usual size and we’ll help you choose.{% endif %}</p>
            {%- endif -%}
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="sticky-buy" data-sticky-buy aria-hidden="true">
    <div class="sticky-buy-text">
      <p class="truncate">{{ product.title }}</p>
      <p class="muted micro" data-sticky-meta>{{ current.price | money_without_trailing_zeros }}{% unless single_default %}, {{ current.title }}{% endunless %}</p>
    </div>
    <button type="button" class="btn btn-solid" data-sticky-add tabindex="-1">{% if po_closed %}Pre-orders closed{% else %}{{ add_label }}{% endif %}</button>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/json" data-product-meta>{"colorIndex": {{ color_index | json }}, "singleDefault": {{ single_default | json }}, "addLabel": {{ add_label | json }}, "availText": {{ avail_text | json }}, "closed": {{ po_closed | json }}}</script>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ request.origin | append: product.url | json }},
      {%- if product.featured_media -%}
      "image": [{% for media in product.media limit: 6 %}{{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
      {%- endif -%}
      "description": {{ product.description | strip_html | strip | json }},
      "brand": { "@type": "Brand", "name": {{ settings.brand_name | default: product.vendor | json }} },
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "sku": {{ variant.sku | default: variant.id | append: '' | json }},
            "itemCondition": "https://schema.org/NewCondition",
            "seller": { "@type": "Organization", "name": {{ settings.brand_name | default: shop.name | json }} },
            "name": {{ variant.title | json }},
            "availability": "https://schema.org/{% if variant.available and po_closed == false %}{% if po %}PreOrder{% else %}InStock{% endif %}{% else %}OutOfStock{% endif %}",
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "url": {{ request.origin | append: variant.url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Shop", "item": {{ request.origin | append: routes.all_products_collection_url | json }} },
        {%- if product.type != blank -%}
        {%- assign type_url = product.type | url_for_type -%}
        { "@type": "ListItem", "position": 2, "name": {{ product.type | json }}, "item": {{ request.origin | append: type_url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- else -%}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
</section>

{% schema %}
{
  "name": "Product page",
  "class": "section-main-product",
  "settings": []
}
{% endschema %}
