<section class="shell page-pad narrow">
  <h1 class="page-title page-title-gap" data-rise><span>{{ section.settings.heading | escape }}</span></h1>
  <div class="rte prose">
    {{ section.settings.text }}
    {%- if settings.contact_email != blank -%}<p><a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p>{%- endif -%}
  </div>
  {%- form 'contact', id: 'contact-form', class: 'contact-form' -%}
    {%- if form.posted_successfully? -%}
      <p class="note" role="status" tabindex="-1" autofocus>Thanks. We’ll reply by email.</p>
    {%- else -%}
      {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="form-grid">
        <div><label class="label" for="c-name">Name</label><input class="field" id="c-name" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div><label class="label" for="c-email">Email</label><input class="field" id="c-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
        <div class="span-2"><label class="label" for="c-order">Order number <span class="muted">(optional)</span></label><input class="field" id="c-order" name="contact[order]"></div>
        <div class="span-2"><label class="label" for="c-msg">Message</label><textarea class="field" id="c-msg" name="contact[body]" rows="5" required>{{ form.body }}</textarea></div>
      </div>
      <button type="submit" class="btn btn-solid">Send</button>
    {%- endif -%}
  {%- endform -%}
</section>
{% schema %}
{
  "name": "Contact",
  "class": "section-contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>For questions about an order, sizing or anything else, write to us. Include your order number if you have one.</p>" }
  ]
}
{% endschema %}
