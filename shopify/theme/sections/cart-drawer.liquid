<div class="overlay" id="cart-drawer" data-panel="cart" hidden>
  <div class="overlay-scrim" data-close></div>
  <aside class="drawer drawer-right" role="dialog" aria-modal="true" aria-label="Bag">
    <div class="drawer-head">
      <h2 class="caps">Bag <span class="muted">({{ cart.item_count }})</span></h2>
      <button type="button" class="icon-btn" data-close aria-label="Close bag">{% render 'icon', name: 'close' %}</button>
    </div>
    <div class="drawer-body" data-cart-body>
      {%- if cart.item_count > 0 -%}
        {% render 'cart-lines' %}
      {%- else -%}
        <div class="empty-bag">
          <p class="empty-title">Your bag is empty.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-line">Shop the collection</a>
        </div>
      {%- endif -%}
    </div>
    {%- if cart.item_count > 0 -%}
      <div class="drawer-foot">
        {% render 'cart-summary' %}
        <a href="{{ routes.cart_url }}" class="text-link muted micro">View full bag</a>
      </div>
    {%- endif -%}
  </aside>
  <span hidden data-cart-count-source>{{ cart.item_count }}</span>
</div>

{% schema %}
{ "name": "Bag drawer", "class": "section-cart-drawer", "settings": [] }
{% endschema %}
