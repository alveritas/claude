<section id="newsletter" class="newsletter" aria-labelledby="nl-{{ section.id }}">
  <div class="shell newsletter-inner">
    <h2 id="nl-{{ section.id }}" class="newsletter-title">{{ section.settings.heading | escape }}</h2>
    <p class="muted newsletter-text">{{ section.settings.text | escape }}</p>
    <div class="newsletter-form">
      {% render 'newsletter-form', form_id: 'newsletter-home' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Email sign-up",
  "class": "section-newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "BE FIRST." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New drops, restocks and exclusive releases, sent to your inbox first." }
  ],
  "presets": [{ "name": "Email sign-up" }]
}
{% endschema %}
