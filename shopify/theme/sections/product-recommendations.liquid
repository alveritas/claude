{%- comment -%}
  "You may also like": Shopify's own related-product suggestions, loaded after the page.
{%- endcomment -%}
<section class="shell recos" data-recos data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <h2 class="section-title recos-title">{{ section.settings.heading | escape }}</h2>
    <div class="grid grid--4 joints product-grid-list">
      {%- for rec in recommendations.products -%}
        <div class="grid-cell">{% render 'product-card', product: rec, index: forloop.index0, sizes: '(min-width: 1024px) 25vw, 50vw' %}</div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Related products",
  "class": "section-recos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" }
  ]
}
{% endschema %}
