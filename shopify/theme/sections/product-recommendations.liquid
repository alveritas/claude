{%- comment -%}
  "You may also like": more pieces from the same section as this one (a men's piece suggests men's
  pieces, a women's piece women's), newest first. Rendered with the page, so nothing loads later.
{%- endcomment -%}
{%- liquid
  assign g = ''
  if product.tags contains 'Men'
    assign g = 'Men'
  elsif product.tags contains 'Women'
    assign g = 'Women'
  endif
  assign picks = 0
  for p in collections.all.products
    if p.id == product.id
      continue
    endif
    if g == blank or p.tags contains g
      assign picks = picks | plus: 1
    endif
  endfor
  if picks > 4
    assign picks = 4
  endif
  assign cols = 'grid--4'
  if picks == 3
    assign cols = 'grid--3'
  elsif picks <= 2
    assign cols = 'grid--2'
  endif
-%}
{%- if picks > 0 -%}
<section class="shell recos">
  <h2 class="section-title recos-title">{{ section.settings.heading | escape }}</h2>
  <div class="grid {{ cols }} product-grid-list">
    {%- assign shown = 0 -%}
    {%- for p in collections.all.products -%}
      {%- if p.id == product.id -%}{%- continue -%}{%- endif -%}
      {%- if g != blank -%}{%- unless p.tags contains g -%}{%- continue -%}{%- endunless -%}{%- endif -%}
      {%- if shown >= 4 -%}{%- break -%}{%- endif -%}
      <div class="grid-cell">{% render 'product-card', product: p, index: shown, sizes: '(min-width: 1024px) 25vw, 50vw' %}</div>
      {%- assign shown = shown | plus: 1 -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Related products",
  "class": "section-recos",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" }
  ]
}
{% endschema %}
