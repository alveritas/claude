<section class="shell {% if section.settings.first %}page-pad{% else %}section-pad-sm{% endif %} narrow">
  {%- if section.settings.heading != blank -%}
    {%- if section.settings.first -%}
      <h1 class="page-title page-title-gap">{{ section.settings.heading | escape }}</h1>
    {%- else -%}
      <h2 class="section-title rich-heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
  {%- endif -%}
  <div class="rte prose{% if section.settings.large %} prose--lg{% endif %}">{{ section.settings.text }}</div>
</section>
{% schema %}
{
  "name": "Text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "checkbox", "id": "first", "label": "Page heading (first section on the page)", "default": false },
    { "type": "checkbox", "id": "large", "label": "Larger text", "default": false }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
