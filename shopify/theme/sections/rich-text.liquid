{%- if section.settings.first -%}
  <section class="shell page-pad rich rich--intro">
    {%- if section.settings.heading != blank -%}<h1 class="page-title page-title-gap" data-rise><span>{{ section.settings.heading | escape }}</span></h1>{%- endif -%}
    <div class="rte prose{% if section.settings.large %} prose--lg{% endif %}">{{ section.settings.text }}</div>
  </section>
{%- else -%}
  <section class="shell rich rich--split">
    {%- if section.settings.heading != blank -%}<h2 class="rich-heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="rte prose{% if section.settings.large %} prose--lg{% endif %}">{{ section.settings.text }}</div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Text",
  "class": "section-rich-text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" },
    { "type": "checkbox", "id": "first", "label": "Page heading (first section on the page)", "default": false },
    { "type": "checkbox", "id": "large", "label": "Larger text", "default": false }
  ],
  "presets": [{ "name": "Text" }]
}
{% endschema %}
