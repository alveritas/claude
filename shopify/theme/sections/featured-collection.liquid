{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['drop-001']
  endif
  if collection == blank or collection.products_count == 0
    assign collection = collections.all
  endif
  assign limit = section.settings.limit
  assign n = collection.products.size
  if n > limit
    assign n = limit
  endif
  # Four to a row on larger screens, two on phones; an odd count opens with one wide card on phones.
  assign odd = n | modulo: 2
-%}
<section class="shell section-pad" aria-labelledby="featured-{{ section.id }}">
  <div class="section-head">
    <div>
      <h2 id="featured-{{ section.id }}" class="section-title">{{ section.settings.heading | escape }}</h2>
      <p class="section-sub muted">{% if section.settings.subheading != blank %}{{ section.settings.subheading | escape }}{% else %}{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}{% if settings.preorder_enabled %}, made to order{% endif %}{% endif %}</p>
    </div>
    <a class="text-link section-link" href="{{ collection.url }}">Shop all</a>
  </div>
  {%- if n > 0 -%}
    <div class="grid grid--4 featured-grid">
      {%- for product in collection.products limit: limit -%}
        {%- liquid
          assign cls = ''
          assign card_sizes = '(min-width: 1024px) 25vw, 50vw'
          if forloop.first and odd == 1
            assign cls = 'span-mobile'
            assign card_sizes = '(min-width: 1024px) 25vw, 100vw'
          endif
          assign eager = false
          if forloop.index <= 4
            assign eager = true
          endif
        -%}
        <div class="grid-cell {{ cls }}">
          {% render 'product-card', product: product, sizes: card_sizes, eager: eager, index: forloop.index0 %}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="muted">Products you add in Shopify appear here.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drop 001" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for the Drop 001 collection (or all products)." },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
