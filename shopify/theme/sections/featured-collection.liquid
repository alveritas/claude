{%- comment -%}
  A row of pieces from a collection, in the collection's own order. With a tag (Men or Women) it shows only that
  section's pieces and links to that section; four to a row on larger screens, two on phones.
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['drop-001']
  endif
  if section.settings.all_products or collection == blank or collection.products_count == 0
    assign collection = collections.all
  endif
  assign tag = section.settings.tag | strip
  assign limit = section.settings.limit
  # pieces to leave out of this row (e.g. those already in the cover just above)
  assign skip = section.settings.exclude | map: 'handle'
  # the pieces to go through: hand-picked ones in their own order, or the collection (newest first if asked)
  assign list = collection.products
  if section.settings.sort == 'newest'
    assign list = collection.products | sort: 'created_at' | reverse
  endif
  assign picked = false
  if section.settings.picks != blank and section.settings.picks.size > 0
    assign list = section.settings.picks
    assign picked = true
  endif

  # the pieces this row may show (all of them, or only those carrying the tag)
  assign total = 0
  assign showable = 0
  for product in list
    if tag == blank or product.tags contains tag
      assign total = total | plus: 1
      unless skip contains product.handle
        assign showable = showable | plus: 1
      endunless
    endif
  endfor
  assign n = showable
  if n > limit
    assign n = limit
  endif
  assign odd = n | modulo: 2
  # the count beside the heading: what this row actually shows when pieces are left out
  assign count = total
  if skip.size > 0
    assign count = showable
  endif

  assign view_all = collection.url
  if tag != blank
    assign tag_handle = tag | handle
    assign view_all = routes.all_products_collection_url | append: '/' | append: tag_handle
    # a collection with the tag's name (Men, Women) is that section's own page
    if collections[tag_handle].products_count > 0
      assign view_all = collections[tag_handle].url
    endif
  endif
-%}
<section class="shell section-pad featured{% if section.settings.heading == blank %} featured--bare{% endif %}" aria-labelledby="featured-{{ section.id }}">
  {%- if section.settings.heading == blank -%}
    {%- comment -%} No visible heading: the products are the page. Screen readers still get one. {%- endcomment -%}
    <h2 id="featured-{{ section.id }}" class="sr-only">{% if request.page_type == 'index' %}All pieces{% else %}{{ settings.brand_name | default: shop.name }}{% endif %}</h2>
  {%- else -%}
  <div class="section-head">
    <div>
      {%- liquid
        assign hide_count = false
        if section.settings.subheading == blank
          if picked or section.settings.sort == 'newest' or section.settings.show_count == false
            assign hide_count = true
          endif
        endif
      -%}
      <h2 id="featured-{{ section.id }}" class="section-title"{% unless hide_count %} data-count="{{ count }}"{% endunless %}>{{ section.settings.heading | escape }}</h2>
      {%- unless hide_count -%}
      <p class="section-sub muted">{% if section.settings.subheading != blank %}{{ section.settings.subheading | escape }}{% else %}{{ count }} {% if count == 1 %}piece{% else %}pieces{% endif %}{% if settings.preorder_enabled %}, made to order{% endif %}{% endif %}</p>
      {%- endunless -%}
    </div>
    <a class="text-link section-link" href="{{ section.settings.link | default: view_all }}">{% if section.settings.link_label != blank %}{{ section.settings.link_label | escape }}{% elsif tag != blank %}Shop all {{ tag | downcase }}’s{% else %}Shop all{% endif %}</a>
  </div>
  {%- endif -%}
  {%- if n > 0 -%}
    <div class="grid grid--4 featured-grid">
      {%- assign shown = 0 -%}
      {%- for product in list -%}
        {%- if tag != blank -%}{%- unless product.tags contains tag -%}{%- continue -%}{%- endunless -%}{%- endif -%}
        {%- if skip contains product.handle -%}{%- continue -%}{%- endif -%}
        {%- if shown >= limit -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign cls = ''
          assign card_sizes = '(min-width: 1024px) 25vw, 50vw'
          if shown == 0 and odd == 1
            assign cls = 'span-mobile'
            assign card_sizes = '(min-width: 1024px) 25vw, 100vw'
          endif
          assign eager = false
          if shown < 4
            assign eager = true
          endif
        -%}
        <div class="grid-cell {{ cls }}">
          {% render 'product-card', product: product, sizes: card_sizes, eager: eager, index: shown %}
        </div>
        {%- assign shown = shown | plus: 1 -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="muted">Products you add in Shopify appear here.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Drop 001", "info": "Leave empty to show only the products, with no heading above them." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "checkbox", "id": "show_count", "label": "Show how many pieces", "default": true, "info": "The small count beside the heading, when there's no subheading." },
    { "type": "url", "id": "link", "label": "Link beside the heading", "info": "Leave empty to link to the collection this row comes from." },
    { "type": "text", "id": "link_label", "label": "Link text", "info": "Leave empty for \"Shop all\"." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for the Drop 001 collection (or all products)." },
    { "type": "checkbox", "id": "all_products", "label": "Use every piece in the store", "default": false, "info": "For a New arrivals row: pair it with Newest first." },
    { "type": "text", "id": "tag", "label": "Only pieces tagged", "info": "Men or Women shows just that section, with a link to it. Leave empty for every piece." },
    { "type": "product_list", "id": "picks", "label": "Hand-picked pieces", "limit": 12, "info": "Shown in this order instead of the collection." },
    { "type": "select", "id": "sort", "label": "Order", "default": "collection", "options": [{ "value": "collection", "label": "The collection's own order" }, { "value": "newest", "label": "Newest first" }] },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 24, "step": 1, "default": 8 },
    { "type": "product_list", "id": "exclude", "label": "Leave out", "limit": 8, "info": "For example the pieces already shown in the cover above, so the page doesn't repeat itself." }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
