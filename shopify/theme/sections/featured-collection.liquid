{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign collection = collections['drop-001']
  endif
  if collection == blank or collection.products_count == 0
    assign collection = collections.all
  endif
  assign limit = section.settings.limit
  assign n = collection.products.size
  if n > limit
    assign n = limit
  endif
  assign odd = n | modulo: 2
  # On larger screens the grid has six tracks: three to a row, and when the count doesn't divide by
  # three the first pieces (the newest) go two to a row, larger, so every row is full.
  assign rem = n | modulo: 3
  assign big = 0
  if rem == 2
    assign big = 2
  elsif rem == 1 and n > 1
    assign big = 4
  elsif n == 1
    assign big = 1
  endif
-%}
<section class="shell section-pad" aria-labelledby="featured-{{ section.id }}">
  <div class="section-head">
    <div>
      <h2 id="featured-{{ section.id }}" class="section-title" data-rise><span>{{ section.settings.heading | escape }}</span></h2>
      <p class="muted small">{% if section.settings.subheading != blank %}{{ section.settings.subheading | escape }}{% else %}{{ n }} {% if n == 1 %}piece{% else %}pieces{% endif %}{% if settings.preorder_enabled %}, made to order{% endif %}{% endif %}</p>
    </div>
    <a class="text-link caps" href="{{ collection.url }}">View all</a>
  </div>
  {%- if n > 0 -%}
    <div class="grid featured-grid grid--six">
      {%- for product in collection.products limit: limit -%}
        {%- liquid
          assign cls = 'span-third'
          assign card_sizes = '(min-width: 768px) 33vw, 50vw'
          if forloop.index <= big
            assign cls = 'span-half'
            assign card_sizes = '(min-width: 768px) 50vw, 50vw'
          endif
          if forloop.first and odd == 1
            assign cls = cls | append: ' span-mobile'
            assign card_sizes = card_sizes | replace: ', 50vw', ', 100vw'
          endif
          assign eager = false
          if forloop.index <= 2
            assign eager = true
          endif
        -%}
        <div class="grid-cell {{ cls }}">
          {% render 'product-card', product: product, sizes: card_sizes, eager: eager, index: forloop.index0 %}
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="muted">Products you add in Shopify appear here.</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "DROP 001" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty for the Drop 001 collection (or all products)." },
    { "type": "range", "id": "limit", "label": "Products shown", "min": 2, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
