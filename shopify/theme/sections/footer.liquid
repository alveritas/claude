{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign live_types = collections.all.products | map: 'type' | uniq | sort
-%}
<footer class="site-footer">
  <div class="shell footer-top">
    <div class="footer-brand">
      {%- comment -%} The homepage has its own sign-up section, so the footer doesn't repeat it there. {%- endcomment -%}
      {%- unless request.page_type == 'index' -%}
        <p class="footer-heading">{{ section.settings.signup_heading }}</p>
        <p class="muted small">{{ section.settings.signup_text }}</p>
        {% render 'newsletter-form', form_id: 'newsletter-footer', compact: true %}
      {%- else -%}
        <p class="footer-heading">Independent unisex streetwear</p>
        <p class="muted small">Made in small runs. Sold first to the people on the list.</p>
      {%- endunless -%}
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <p class="label footer-label">Shop</p>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          {%- for type in live_types -%}
            {%- if type != blank -%}<li><a href="{{ type | url_for_type }}">{{ type }}</a></li>{%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <p class="label footer-label">Help</p>
        <ul>
          <li><a href="/pages/faq">FAQ</a></li>
          {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
          {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}">Returns</a></li>{%- endif -%}
          <li><a href="/pages/contact">Contact</a></li>
          {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">Account</a></li>{%- endif -%}
        </ul>
      </div>

      <div class="footer-col">
        <p class="label footer-label">{{ brand }}</p>
        <ul>
          <li><a href="/pages/about">About</a></li>
          {%- if settings.instagram_url != blank -%}<li><a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
          {%- if settings.tiktok_url != blank -%}<li><a href="{{ settings.tiktok_url }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
          {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy</a></li>{%- endif -%}
          {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms</a></li>{%- endif -%}
        </ul>
      </div>
    </nav>
  </div>

  <div class="shell footer-mark">
    <a href="{{ routes.root_url }}" class="footer-logo" aria-label="{{ brand | escape }}, home">
      <span class="brand-mark brand-wordmark" aria-hidden="true" data-ink></span>
    </a>
  </div>

  <div class="shell footer-bottom">
    <p class="micro muted">&copy; {{ 'now' | date: '%Y' }} {{ brand }}{% if settings.contact_email != blank %} · <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>{% endif %}</p>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="pay-icons" aria-label="Ways to pay">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "text", "id": "signup_heading", "label": "Sign-up heading", "default": "Join the list" },
    { "type": "text", "id": "signup_text", "label": "Sign-up text", "default": "One email when something new drops or comes back." }
  ]
}
{% endschema %}
