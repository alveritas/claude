{%- liquid
  assign brand = settings.brand_name | default: shop.name
  assign live_types = collections.all.products | map: 'type' | uniq | sort
-%}
<footer class="site-footer">
  {%- if settings.gallery_mode -%}
  <div class="shell footer-gallery">
    <nav class="footer-gallery-links" aria-label="Footer">
      <ul>
        {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">Track order</a></li>{%- endif -%}
        <li><a href="/pages/contact">Contact us</a></li>
        {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
        {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}">Refund policy</a></li>{%- endif -%}
        {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms of service</a></li>{%- endif -%}
        {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy policy</a></li>{%- endif -%}
      </ul>
      <ul>
        <li><a href="/pages/about">About</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        {%- if settings.instagram_url != blank -%}<li><a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
        {%- if settings.tiktok_url != blank -%}<li><a href="{{ settings.tiktok_url }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
      </ul>
    </nav>
    {%- liquid
      assign g_code = settings.offer_code | strip
      assign g_line = 'Email for new drops'
      if settings.offer_enabled and g_code != blank and settings.offer_amount != blank
        assign g_line = 'Email for ' | append: settings.offer_amount
      endif
    -%}
    <div class="footer-gallery-form">{% render 'newsletter-form', form_id: 'newsletter-footer', compact: true, line: g_line %}</div>
    <p class="footer-gallery-copy">&copy; {{ 'now' | date: '%Y' }} {{ brand }}</p>
  </div>
  {%- elsif section.settings.simple -%}
  <div class="shell footer-simple">
    <a href="{{ routes.root_url }}" class="footer-logo" aria-label="{{ brand | escape }}, home"><span class="brand-mark brand-wordmark" aria-hidden="true"></span></a>
    <nav aria-label="Footer">
      <ul class="footer-links">
        <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
        <li><a href="/pages/about">About</a></li>
        <li><a href="/pages/faq">FAQ</a></li>
        {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
        {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}">Returns</a></li>{%- endif -%}
        <li><a href="/pages/contact">Contact</a></li>
        {%- if settings.instagram_url != blank -%}<li><a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
        {%- if settings.tiktok_url != blank -%}<li><a href="{{ settings.tiktok_url }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
        {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy</a></li>{%- endif -%}
        {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms</a></li>{%- endif -%}
      </ul>
    </nav>
  </div>
  {%- else -%}
  <div class="shell footer-top">
    <div class="footer-brand">
      {%- comment -%} The homepage has its own sign-up section, so the footer doesn't repeat it there. {%- endcomment -%}
      {%- unless request.page_type == 'index' -%}
        {%- liquid
          assign f_heading = section.settings.signup_heading
          assign f_text = section.settings.signup_text
          assign offer_code = settings.offer_code | strip
          if settings.offer_enabled and offer_code != blank
            assign f_heading = settings.offer_heading
            assign f_text = settings.offer_text
          endif
        -%}
        <p class="footer-heading">{{ f_heading | escape }}</p>
        <p class="muted small">{{ f_text | escape }}</p>
        {% render 'newsletter-form', form_id: 'newsletter-footer', compact: true %}
      {%- else -%}
        <p class="footer-heading">{{ brand }}</p>
        <p class="muted small">{{ section.settings.brand_text | escape }}</p>
      {%- endunless -%}
    </div>

    <nav class="footer-cols" aria-label="Footer">
      <div class="footer-col">
        <p class="label footer-label">Shop</p>
        <ul>
          <li><a href="{{ routes.all_products_collection_url }}">All products</a></li>
          {%- if collections['men'].products_count > 0 -%}<li><a href="{{ collections['men'].url }}">Men</a></li>{%- endif -%}
          {%- if collections['women'].products_count > 0 -%}<li><a href="{{ collections['women'].url }}">Women</a></li>{%- endif -%}
          <li><a href="{{ routes.collections_url }}">Collections</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <p class="label footer-label">Help</p>
        <ul>
          <li><a href="/pages/faq">FAQ</a></li>
          {%- if shop.shipping_policy.url != blank -%}<li><a href="{{ shop.shipping_policy.url }}">Shipping</a></li>{%- endif -%}
          {%- if shop.refund_policy.url != blank -%}<li><a href="{{ shop.refund_policy.url }}">Returns</a></li>{%- endif -%}
          <li><a href="/pages/contact">Contact</a></li>
          {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">Account</a></li>{%- endif -%}
        </ul>
      </div>

      <div class="footer-col">
        <p class="label footer-label">{{ brand }}</p>
        <ul>
          <li><a href="/pages/about">About</a></li>
          {%- if settings.instagram_url != blank -%}<li><a href="{{ settings.instagram_url }}" rel="noopener" target="_blank">Instagram</a></li>{%- endif -%}
          {%- if settings.tiktok_url != blank -%}<li><a href="{{ settings.tiktok_url }}" rel="noopener" target="_blank">TikTok</a></li>{%- endif -%}
          {%- if shop.privacy_policy.url != blank -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy</a></li>{%- endif -%}
          {%- if shop.terms_of_service.url != blank -%}<li><a href="{{ shop.terms_of_service.url }}">Terms</a></li>{%- endif -%}
        </ul>
      </div>
    </nav>
  </div>

  <div class="shell footer-mark">
    <a href="{{ routes.root_url }}" class="footer-logo" aria-label="{{ brand | escape }}, home">
      <span class="wipe" aria-hidden="true" data-ink><span class="brand-mark brand-wordmark"></span></span>
    </a>
  </div>

  {%- endif -%}
  {%- unless settings.gallery_mode -%}
  <div class="shell footer-bottom">
    <p class="micro muted">&copy; {{ 'now' | date: '%Y' }} {{ brand }}{% if settings.contact_email != blank %} · <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>{% endif %}</p>
    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="pay-icons" aria-label="Ways to pay">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag: class: 'pay-icon' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
  {%- endunless -%}
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "settings": [
    { "type": "checkbox", "id": "simple", "label": "Simple footer", "default": true, "info": "Logo and one row of links instead of columns and a sign-up form." },
    { "type": "text", "id": "signup_heading", "label": "Sign-up heading", "default": "Mailing list" },
    { "type": "text", "id": "signup_text", "label": "Sign-up text", "default": "New releases and restocks, by email." },
    { "type": "textarea", "id": "brand_text", "label": "Brand line (homepage)", "default": "An independent clothing label." }
  ]
}
{% endschema %}
