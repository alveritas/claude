<section class="shell page-pad auth">
  <h1 class="page-title page-title-gap">Create account</h1>
  {%- form 'create_customer', class: 'auth-form', novalidate: 'novalidate' -%}
    {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div><label class="label" for="reg-first">First name</label><input class="field" id="reg-first" name="customer[first_name]" autocomplete="given-name"></div>
    <div><label class="label" for="reg-last">Last name</label><input class="field" id="reg-last" name="customer[last_name]" autocomplete="family-name"></div>
    <div><label class="label" for="reg-email">Email</label><input class="field" id="reg-email" type="email" name="customer[email]" autocomplete="email" required></div>
    <div><label class="label" for="reg-pw">Password</label><input class="field" id="reg-pw" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <label class="check-row"><input type="checkbox" class="check" name="customer[accepts_marketing]" value="true"> <span class="muted small">Email me about new drops and restocks.</span></label>
    <button type="submit" class="btn btn-solid btn-block">Create account</button>
    <p class="muted small">Already have one? <a class="text-link" href="{{ routes.account_login_url }}">Sign in</a></p>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Create account", "class": "section-register", "settings": [] }
{% endschema %}
