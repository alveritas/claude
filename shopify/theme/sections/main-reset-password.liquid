<section class="shell page-pad auth">
  <h1 class="page-title page-title-gap">Choose a new password</h1>
  {%- form 'reset_customer_password', class: 'auth-form' -%}
    {%- if form.errors -%}<p class="form-error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div><label class="label" for="rp-pw">New password</label><input class="field" id="rp-pw" type="password" name="customer[password]" autocomplete="new-password"></div>
    <div><label class="label" for="rp-pw2">Confirm password</label><input class="field" id="rp-pw2" type="password" name="customer[password_confirmation]" autocomplete="new-password"></div>
    <button type="submit" class="btn btn-solid btn-block">Save password</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Reset password", "class": "section-reset", "settings": [] }
{% endschema %}
