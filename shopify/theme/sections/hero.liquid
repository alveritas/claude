{%- comment -%}
  The cover: two models on a background matched to the page colour, legs fading into it. The words
  sit beside the photo on larger screens and under it on phones, never on top of it.
{%- endcomment -%}
{%- liquid
  # While pre-orders are on, an "out now" line is swapped for the pre-order line (Theme settings → Pre-orders).
  assign po_on = false
  assign po_line = ''
  assign po_ship = ''
  if settings.preorder_enabled
    assign po_on = true
    assign po_line = settings.preorder_line_open
    if settings.preorder_ship != blank
      assign po_ship = settings.preorder_ship | append: 'T12:00:00' | date: '%B %-d, %Y'
    endif
    if settings.preorder_close != blank
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_line = settings.preorder_line_closed
        assign po_ship = ''
      endif
    endif
  endif
-%}
<section class="hero" aria-label="Introduction" data-hero>
  <div class="hero-parallax" data-parallax>
    <div class="hero-frame">
      {%- if section.settings.image != blank -%}
        {%- assign hero_alt = section.settings.image.alt | default: section.settings.image_alt -%}
        {{ section.settings.image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 1024px) 60vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt, class: 'hero-img' }}
      {%- else -%}
        <img class="hero-img" src="{{ 'nh-cover-thorn.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="941" height="1672" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content">
    <div class="hero-copy">
      {%- liquid
        assign status = section.settings.status
        assign status_down = status | downcase
        if po_on and status_down contains 'out now' and po_line != blank
          assign status = po_line
        endif
      -%}
      {%- if status != blank -%}<p class="caps muted">{{ status | escape }}</p>{%- endif -%}
      <h1 class="hero-title">{{ section.settings.heading | escape }}</h1>
      <p class="hero-tagline">{{ section.settings.tagline | escape }}</p>
      <div class="hero-buttons">
        <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn btn-solid">{{ section.settings.primary_label | escape }}</a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '/pages/about' }}" class="btn btn-line">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cover",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Cover photo", "info": "A photo on a white or transparent background works best. Leave empty for the NEVERHOLLOW two-model cover." },
    { "type": "text", "id": "image_alt", "label": "Cover description (for screen readers)", "default": "Two models in washed black Neverhollow fur hood hoodies with thorn vines down the sleeves and wide black jeans, one seated on a white block" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "NEVERHOLLOW" },
    { "type": "text", "id": "tagline", "label": "Supporting line", "default": "An identity without explanation." },
    { "type": "text", "id": "status", "label": "Release line", "default": "DROP 001 — OUT NOW" },
    { "type": "text", "id": "primary_label", "label": "First button", "default": "Shop the collection" },
    { "type": "url", "id": "primary_link", "label": "First button link" },
    { "type": "text", "id": "secondary_label", "label": "Second button", "default": "Explore Neverhollow" },
    { "type": "url", "id": "secondary_link", "label": "Second button link", "info": "Leave empty for the About page." }
  ],
  "presets": [{ "name": "Cover" }]
}
{% endschema %}
