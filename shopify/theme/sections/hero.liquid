{%- comment -%}
  The cover: a black slab carrying the script logo, beside a photo of the clothes on concrete.
  The words never sit on the photo, so they don't compete with the script printed on the pieces.
{%- endcomment -%}
{%- liquid
  # While pre-orders are on, an "out now" line is swapped for the pre-order line (Theme settings → Pre-orders).
  assign po_on = false
  assign po_line = ''
  assign po_ship = ''
  assign po_close = ''
  if settings.preorder_enabled
    assign po_on = true
    assign po_line = settings.preorder_line_open
    if settings.preorder_ship != blank
      assign po_ship = settings.preorder_ship | append: 'T12:00:00' | date: '%b %-d, %Y'
    endif
    if settings.preorder_close != blank
      assign po_close = settings.preorder_close | append: 'T12:00:00' | date: '%b %-d, %Y'
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_line = settings.preorder_line_closed
        assign po_ship = ''
        assign po_close = ''
      endif
    endif
  endif
  assign status = section.settings.status
  assign status_down = status | downcase
  if po_on and status_down contains 'out now' and po_line != blank
    assign status = po_line
  endif
  # The announcement bar already says pre-orders are open, and the dates below say when; don't repeat it here.
  if po_ship != blank and status == po_line
    assign status = ''
  endif
-%}
<section class="hero" aria-label="Introduction">
  <div class="hero-slab slab">
    <p class="hero-status">{{ status | escape }}</p>
    <h1><span class="sr-only">{{ section.settings.heading | escape }}</span><span class="brand-mark brand-wordmark hero-mark" aria-hidden="true"></span></h1>
    <div class="hero-foot">
      <div>
        <p class="hero-tagline">{{ section.settings.tagline | escape }}</p>
        {%- if po_ship != blank -%}
          <dl class="hero-dates">
            {%- if po_close != blank -%}<div><dt>Pre-order until</dt><dd>{{ po_close }}</dd></div>{%- endif -%}
            <div><dt>Ships by</dt><dd>{{ po_ship }}</dd></div>
          </dl>
        {%- endif -%}
      </div>
      <div class="hero-buttons">
        <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn btn-solid">{{ section.settings.primary_label | escape }}</a>
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: '/pages/about' }}" class="btn btn-line">{{ section.settings.secondary_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
  {%- comment -%}
    Three photos, one per piece, changing every few seconds. Each says which piece it shows and
    links to it. Pointing at or focusing the photo pauses it; with reduced motion it stays on the first.
  {%- endcomment -%}
  {%- liquid
    assign default_imgs = 'hero-feral.webp,nh-hero-relic.webp,hero-spine.webp' | split: ','
    assign default_dims = '939x1252,1200x1600,1200x1600' | split: ','
    assign default_handles = 'feral-zip-hoodie,relic-denim,spine-long-sleeve' | split: ','
    assign default_alts = 'A model in the Feral Zip Hoodie with the hood up, leaning on a concrete pillar|A model in a hood and Relic Denim leaning on a concrete wall|Two models in the Spine Long Sleeve in Obsidian and Bone against a concrete wall' | split: '|'
  -%}
  <div class="hero-photo" data-hero-slides aria-roledescription="carousel" aria-label="Pieces in this drop">
    {%- for i in (1..3) -%}
      {%- liquid
        assign idx = i | minus: 1
        assign img_key = 'image_' | append: i
        assign prod_key = 'product_' | append: i
        assign img = section.settings[img_key]
        assign p = section.settings[prod_key]
        if p == blank
          assign p = all_products[default_handles[idx]]
        endif
        assign dims = default_dims[idx] | split: 'x'
      -%}
      <figure class="hero-slide{% if forloop.first %} is-active{% endif %}" data-hero-slide aria-roledescription="slide" aria-label="{{ i }} of 3"{% unless forloop.first %} aria-hidden="true"{% endunless %}>
        {%- if img != blank -%}
          {%- if forloop.first -%}
            {{ img | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 42vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: img.alt, class: 'hero-img' }}
          {%- else -%}
            {{ img | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 1024px) 42vw, 100vw', loading: 'lazy', alt: img.alt, class: 'hero-img' }}
          {%- endif -%}
        {%- else -%}
          <img class="hero-img" src="{{ default_imgs[idx] | asset_url }}" alt="{{ default_alts[idx] | escape }}" width="{{ dims[0] }}" height="{{ dims[1] }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %}>
        {%- endif -%}
        {%- if p != blank and p.available != nil -%}
          <figcaption class="hero-caption"><a href="{{ p.url }}" {% unless forloop.first %}tabindex="-1"{% endunless %}><span class="hero-caption-name">{{ p.title }}</span><span class="hero-caption-price">{{ p.price | money_without_trailing_zeros }}</span></a></figcaption>
        {%- endif -%}
      </figure>
    {%- endfor -%}
    <div class="hero-progress" role="group" aria-label="Choose a photo">
      {%- for i in (1..3) -%}
        <button type="button" class="hero-tick" data-hero-tick="{{ forloop.index0 }}" aria-label="Show photo {{ i }}" {% if forloop.first %}aria-current="true"{% endif %}><span></span></button>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cover",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Photos", "info": "Three tall photos rotate beside the logo. Leave them empty to use the Feral, Relic and Spine photos. Each links to the piece chosen under it." },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "product", "id": "product_1", "label": "Piece in photo 1" },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "product", "id": "product_2", "label": "Piece in photo 2" },
    { "type": "image_picker", "id": "image_3", "label": "Photo 3" },
    { "type": "product", "id": "product_3", "label": "Piece in photo 3" },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "heading", "label": "Headline (read out by screen readers; the logo shows instead)", "default": "NEVERHOLLOW" },
    { "type": "text", "id": "tagline", "label": "Supporting line", "default": "An identity without explanation." },
    { "type": "text", "id": "status", "label": "Release line", "default": "Drop 001 is out now" },
    { "type": "text", "id": "primary_label", "label": "First button", "default": "Shop the drop" },
    { "type": "url", "id": "primary_link", "label": "First button link" },
    { "type": "text", "id": "secondary_label", "label": "Second button", "default": "About Neverhollow" },
    { "type": "url", "id": "secondary_link", "label": "Second button link", "info": "Leave empty for the About page." }
  ],
  "presets": [{ "name": "Cover" }]
}
{% endschema %}
