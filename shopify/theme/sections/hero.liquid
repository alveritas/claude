{%- comment -%}
  The cover: two studio photos side by side (on phones, a pair you swipe between, turning by itself),
  each one a way into its piece. Under them, the line, the dates and the way in. No words sit on the
  photos, so nothing competes with the script printed on the clothes.
{%- endcomment -%}
{%- liquid
  # While pre-orders are on, an "out now" line is swapped for the pre-order line (Theme settings → Pre-orders).
  assign po_on = false
  assign po_line = ''
  assign po_ship = ''
  assign po_close = ''
  if settings.preorder_enabled
    assign po_on = true
    assign po_line = settings.preorder_line_open
    if settings.preorder_ship != blank
      assign po_ship = settings.preorder_ship | append: 'T12:00:00' | date: '%b %-d, %Y'
    endif
    if settings.preorder_close != blank
      assign po_close = settings.preorder_close | append: 'T12:00:00' | date: '%b %-d, %Y'
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_line = settings.preorder_line_closed
        assign po_ship = ''
        assign po_close = ''
      endif
    endif
  endif
  assign status = section.settings.status
  assign status_down = status | downcase
  if po_on and status_down contains 'out now' and po_line != blank
    assign status = po_line
  endif
  # The announcement bar already says pre-orders are open, and the dates below say when; don't repeat it here.
  if po_ship != blank and status == po_line
    assign status = ''
  endif
-%}
<section class="hero" aria-label="Introduction" data-hero>
  <div class="hero-slides" data-hero-slides>
    {%- for i in (1..2) -%}
      {%- liquid
        assign key_img = 'image_' | append: i
        assign key_product = 'product_' | append: i
        assign img = section.settings[key_img]
        assign piece = section.settings[key_product]
        if piece == blank
          if i == 1
            assign piece = all_products['vesper-polo']
          else
            assign piece = all_products['veil-cropped-long-sleeve']
          endif
        endif
        if piece != blank and piece.id != blank
          assign slide_url = piece.url
          assign slide_label = piece.title
        else
          assign slide_url = section.settings.primary_link | default: routes.all_products_collection_url
          assign slide_label = section.settings.primary_label
        endif
        if i == 1
          assign fallback = 'campaign-vesper'
          assign fallback_alt = 'A model in the Vesper Polo lying on a white floor'
        else
          assign fallback = 'campaign-veil'
          assign fallback_alt = 'A model in the Veil Cropped Long Sleeve lying on a white floor'
        endif
        assign load = 'eager'
        assign priority = 'high'
        if i > 1
          assign priority = 'auto'
        endif
      -%}
      <a class="hero-slide" href="{{ slide_url }}" data-hero-slide data-cursor="{{ slide_label | escape }}" style="--i: {{ i | minus: 1 }}">
        <span class="hero-frame">
          {%- if img != blank -%}
            {{ img | image_url: width: 1600 | image_tag: widths: '720, 1100, 1600', sizes: '(min-width: 64rem) 50vw, 100vw', loading: load, fetchpriority: priority, alt: img.alt, class: 'hero-img' }}
          {%- else -%}
            <img class="hero-img" src="{{ fallback | append: '-1100.webp' | asset_url }}" srcset="{{ fallback | append: '-720.webp' | asset_url }} 720w, {{ fallback | append: '-1100.webp' | asset_url }} 1100w, {{ fallback | append: '-1600.webp' | asset_url }} 1600w" sizes="(min-width: 64rem) 50vw, 100vw" alt="{{ fallback_alt }}" width="1600" height="2133" fetchpriority="{{ priority }}">
          {%- endif -%}
        </span>
        <span class="hero-caption">{{ slide_label | escape }}<span class="hero-caption-arrow" aria-hidden="true"></span></span>
      </a>
    {%- endfor -%}
  </div>
  <div class="hero-dots" aria-hidden="true" data-hero-dots><span><i></i></span><span><i></i></span></div>
  <div class="shell hero-copy">
    {%- if status != blank -%}<p class="hero-status">{{ status | escape }}</p>{%- endif -%}
    <h1 class="hero-tagline"><span class="sr-only">{{ section.settings.heading | escape }}. </span>{{ section.settings.tagline | escape }}</h1>
    {%- if po_ship != blank -%}
      <dl class="hero-dates">
        {%- if po_close != blank -%}<div><dt>Pre-order until</dt><dd>{{ po_close }}</dd></div>{%- endif -%}
        <div><dt>Ships by</dt><dd>{{ po_ship }}</dd></div>
      </dl>
    {%- endif -%}
    <div class="hero-buttons">
      <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}" class="btn btn-solid">{{ section.settings.primary_label | escape }}</a>
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link | default: '/pages/about' }}" class="text-link caps">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cover",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Photos", "info": "Two tall photos, side by side on a computer and swiped between on a phone. Each opens its piece. Leave empty to use the Vesper Polo and Veil Cropped Long Sleeve studio photos." },
    { "type": "image_picker", "id": "image_1", "label": "Photo 1" },
    { "type": "product", "id": "product_1", "label": "Photo 1 opens", "info": "Leave empty for the Vesper Polo." },
    { "type": "image_picker", "id": "image_2", "label": "Photo 2" },
    { "type": "product", "id": "product_2", "label": "Photo 2 opens", "info": "Leave empty for the Veil Cropped Long Sleeve." },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "heading", "label": "Brand name (read out by screen readers)", "default": "NEVERHOLLOW" },
    { "type": "text", "id": "tagline", "label": "Headline", "default": "An identity without explanation." },
    { "type": "text", "id": "status", "label": "Release line", "default": "Drop 001 is out now" },
    { "type": "text", "id": "primary_label", "label": "Button", "default": "Shop the drop" },
    { "type": "url", "id": "primary_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Link", "default": "About Neverhollow" },
    { "type": "url", "id": "secondary_link", "label": "Link destination", "info": "Leave empty for the About page." }
  ],
  "presets": [{ "name": "Cover" }]
}
{% endschema %}
