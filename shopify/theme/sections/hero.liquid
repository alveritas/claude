{%- comment -%}
  The cover: two studio photos side by side on one seamless backdrop, then the release, its dates and
  the way in, then a short strip of the facts people ask first (shipping, how it's made, who to ask).
  No words sit on the photos, so nothing competes with the script printed on the clothes.
{%- endcomment -%}
{%- liquid
  # Pre-order dates come from Theme settings → Pre-orders; once pre-orders close they stop showing.
  assign po_on = false
  assign po_ship = ''
  assign po_close = ''
  if settings.preorder_enabled
    assign po_on = true
    if settings.preorder_ship != blank
      assign po_ship = settings.preorder_ship | append: 'T12:00:00' | date: '%B %-d, %Y'
    endif
    if settings.preorder_close != blank
      assign po_close = settings.preorder_close | append: 'T12:00:00' | date: '%B %-d, %Y'
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_on = false
        assign po_ship = ''
        assign po_close = ''
      endif
    endif
  endif
  assign shop_url = section.settings.primary_link | default: routes.all_products_collection_url
-%}
<section class="hero" aria-labelledby="hero-{{ section.id }}" data-hero>
  <a class="hero-spread" href="{{ shop_url }}" tabindex="-1" aria-hidden="true">
    <span class="hero-look">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '720, 1100, 1600', sizes: '50vw', loading: 'eager', fetchpriority: 'high', alt: '', class: 'hero-img' }}
      {%- else -%}
        <img class="hero-img" src="{{ 'look-sigil-1100.webp' | asset_url }}" srcset="{{ 'look-sigil-720.webp' | asset_url }} 720w, {{ 'look-sigil-1100.webp' | asset_url }} 1100w, {{ 'look-sigil-1600.webp' | asset_url }} 1600w" sizes="50vw" alt="" width="1600" height="2133" fetchpriority="high">
      {%- endif -%}
    </span>
    <span class="hero-look">
      {%- if section.settings.image_2 != blank -%}
        {{ section.settings.image_2 | image_url: width: 1600 | image_tag: widths: '720, 1100, 1600', sizes: '50vw', loading: 'eager', alt: '', class: 'hero-img' }}
      {%- else -%}
        <img class="hero-img" src="{{ 'look-veil-1100.webp' | asset_url }}" srcset="{{ 'look-veil-720.webp' | asset_url }} 720w, {{ 'look-veil-1100.webp' | asset_url }} 1100w, {{ 'look-veil-1600.webp' | asset_url }} 1600w" sizes="50vw" alt="" width="1600" height="2133">
      {%- endif -%}
    </span>
  </a>
  <p class="sr-only">{{ section.settings.photo_description | escape }}</p>

  <div class="shell hero-copy">
    <h1 id="hero-{{ section.id }}" class="hero-title"><span class="sr-only">{{ section.settings.heading | escape }}: </span>{{ section.settings.tagline | escape }}</h1>
    {%- if po_ship != blank -%}
      <p class="hero-sub">{% if po_close != blank %}Pre-order until {{ po_close }}. {% endif %}Ships by {{ po_ship }}.</p>
    {%- elsif section.settings.status != blank -%}
      <p class="hero-sub">{{ section.settings.status | escape }}</p>
    {%- endif -%}
    <div class="hero-buttons">
      <a href="{{ shop_url }}" class="btn btn-solid">{{ section.settings.primary_label | escape }}</a>
      {%- if section.settings.secondary_label != blank -%}
        {%- assign second_url = routes.all_products_collection_url | append: '/women' -%}
        {%- if section.settings.secondary_link != blank -%}{%- assign second_url = section.settings.secondary_link -%}{%- endif -%}
        <a href="{{ second_url }}" class="btn btn-line">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_facts -%}
    <div class="shell">
      <dl class="facts">
        {%- if settings.shipping_summary != blank -%}
          <div class="fact"><dt>Shipping</dt><dd>{{ settings.shipping_summary | escape }}</dd></div>
        {%- endif -%}
        {%- if po_on -%}
          <div class="fact"><dt>Made to order</dt><dd>Every piece is made in one production run once pre-orders close.</dd></div>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <div class="fact"><dt>Questions</dt><dd><a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></dd></div>
        {%- endif -%}
      </dl>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cover",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Left photo", "info": "Tall studio photos on a white background work best. Leave empty to use the Sigil Hoodie studio photo." },
    { "type": "image_picker", "id": "image_2", "label": "Right photo", "info": "Leave empty to use the Veil Cropped Long Sleeve studio photo." },
    { "type": "text", "id": "photo_description", "label": "Photo description (read out by screen readers)", "default": "Two models in Drop 001: one in the Sigil Hoodie, one in the Veil Cropped Long Sleeve." },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "heading", "label": "Brand name (read out by screen readers)", "default": "NEVERHOLLOW" },
    { "type": "text", "id": "tagline", "label": "Headline", "default": "Drop 001" },
    { "type": "text", "id": "status", "label": "Line under the headline", "info": "Shown only when pre-orders are off. While they're on, the pre-order and ship-by dates show here instead." },
    { "type": "text", "id": "primary_label", "label": "Button", "default": "Shop the collection" },
    { "type": "url", "id": "primary_link", "label": "Button link" },
    { "type": "text", "id": "secondary_label", "label": "Second button", "default": "Shop women" },
    { "type": "url", "id": "secondary_link", "label": "Second button link", "info": "Leave empty for the women's pieces (products tagged Women)." },
    { "type": "checkbox", "id": "show_facts", "label": "Show shipping, how it's made and contact under the cover", "default": true }
  ],
  "presets": [{ "name": "Cover" }]
}
{% endschema %}
