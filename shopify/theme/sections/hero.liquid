{%- comment -%}
  The cover: one studio photo on pure white, so the photo has no edge and simply becomes the page.
  The release, its dates and the way in sit beside it (under it on phones), then a short strip of the
  facts people ask first.
{%- endcomment -%}
{%- liquid
  # Pre-order dates come from Theme settings → Pre-orders; once pre-orders close they stop showing.
  assign po_on = false
  assign po_ship = ''
  assign po_close = ''
  if settings.preorder_enabled
    assign po_on = true
    if settings.preorder_ship != blank
      assign po_ship = settings.preorder_ship | append: 'T12:00:00' | date: '%B %-d, %Y'
    endif
    if settings.preorder_close != blank
      assign po_close = settings.preorder_close | append: 'T12:00:00' | date: '%B %-d, %Y'
      assign po_today = 'now' | date: '%Y%m%d' | plus: 0
      assign po_last = settings.preorder_close | remove: '-' | plus: 0
      if po_today > po_last
        assign po_on = false
        assign po_ship = ''
        assign po_close = ''
      endif
    endif
  endif
  # The two buttons default to the Men and Women collections; a link set in the editor wins, and
  # without those collections they fall back to every piece.
  assign shop_url = routes.all_products_collection_url
  if collections['men'].products_count > 0
    assign shop_url = collections['men'].url
  endif
  if section.settings.primary_link != blank
    assign shop_url = section.settings.primary_link
  endif
  assign second_url = routes.all_products_collection_url
  if collections['women'].products_count > 0
    assign second_url = collections['women'].url
  endif
  if section.settings.secondary_link != blank
    assign second_url = section.settings.secondary_link
  endif

  # The built-in studio photos, chosen in the theme editor (an uploaded photo overrides them).
  case section.settings.look
    when 'vesper'
      assign look = 'campaign-vesper'
      assign look_alt = 'A model in the Vesper Polo lying on a white floor, the Neverhollow script across the chest'
    when 'veil'
      assign look = 'look-veil'
      assign look_alt = 'A model in the Veil Cropped Long Sleeve, standing, the Neverhollow script across the chest'
    when 'sigil'
      assign look = 'look-sigil'
      assign look_alt = 'A model in the Sigil Hoodie, standing, the NH monogram on the chest'
    else
      assign look = 'look-requiem'
      assign look_alt = 'A model in the Requiem Sweatpants lying on a white floor, the Neverhollow script across the back'
  endcase
-%}
<section class="hero" aria-labelledby="hero-{{ section.id }}" data-hero>
  <a class="hero-photo" href="{{ routes.all_products_collection_url }}" tabindex="-1" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '720, 1100, 1600', sizes: '(min-width: 64rem) 45vw, 100vw', loading: 'eager', fetchpriority: 'high', alt: '', class: 'hero-img' }}
    {%- else -%}
      <img class="hero-img" src="{{ look | append: '-1100.webp' | asset_url }}" srcset="{{ look | append: '-720.webp' | asset_url }} 720w, {{ look | append: '-1100.webp' | asset_url }} 1100w, {{ look | append: '-1600.webp' | asset_url }} 1600w" sizes="(min-width: 64rem) 45vw, 100vw" alt="" width="1600" height="2133" fetchpriority="high">
    {%- endif -%}
  </a>
  <p class="sr-only">{% if section.settings.image != blank %}{{ section.settings.image.alt | default: 'NEVERHOLLOW Drop 001' | escape }}{% else %}{{ look_alt }}{% endif %}</p>

  <div class="shell hero-copy">
    <h1 id="hero-{{ section.id }}" class="hero-title"><span class="sr-only">{{ section.settings.heading | escape }}: </span>{{ section.settings.tagline | escape }}</h1>
    {%- if po_ship != blank -%}
      <p class="hero-sub">{% if po_close != blank %}<span>Pre-order until {{ po_close }}.</span> {% endif %}<span>Ships by {{ po_ship }}.</span></p>
    {%- elsif section.settings.status != blank -%}
      <p class="hero-sub">{{ section.settings.status | escape }}</p>
    {%- endif -%}
    <div class="hero-buttons">
      <a href="{{ shop_url }}" class="btn btn-line">{{ section.settings.primary_label | escape }}</a>
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ second_url }}" class="btn btn-line">{{ section.settings.secondary_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

</section>
{%- if section.settings.show_facts -%}
  <div class="shell hero-facts">
    <dl class="facts">
        {%- if settings.shipping_summary != blank -%}
          <div class="fact"><dt>Shipping</dt><dd>{{ settings.shipping_summary | escape }}</dd></div>
        {%- endif -%}
        {%- if po_on -%}
          <div class="fact"><dt>Made to order</dt><dd>Every piece is made in one production run once pre-orders close.</dd></div>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <div class="fact"><dt>Questions</dt><dd><a class="text-link" href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></dd></div>
        {%- endif -%}
      </dl>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cover",
  "class": "section-hero",
  "settings": [
    {
      "type": "select", "id": "look", "label": "Cover photo", "default": "vesper",
      "options": [
        { "value": "requiem", "label": "Requiem Sweatpants, lying" },
        { "value": "vesper", "label": "Vesper Polo, lying" },
        { "value": "veil", "label": "Veil Cropped Long Sleeve, standing" },
        { "value": "sigil", "label": "Sigil Hoodie, standing" }
      ]
    },
    { "type": "image_picker", "id": "image", "label": "Or upload your own", "info": "A tall photo on a pure white background, so it blends into the page. Overrides the choice above." },
    { "type": "header", "content": "Words" },
    { "type": "text", "id": "heading", "label": "Brand name (read out by screen readers)", "default": "NEVERHOLLOW" },
    { "type": "text", "id": "tagline", "label": "Headline", "default": "Drop 001" },
    { "type": "text", "id": "status", "label": "Line under the headline", "info": "Shown only when pre-orders are off. While they're on, the pre-order and ship-by dates show here instead." },
    { "type": "text", "id": "primary_label", "label": "Button", "default": "Shop men" },
    { "type": "url", "id": "primary_link", "label": "Button link", "info": "Leave empty for the Men collection." },
    { "type": "text", "id": "secondary_label", "label": "Second button", "default": "Shop women" },
    { "type": "url", "id": "secondary_link", "label": "Second button link", "info": "Leave empty for the Women collection." },
    { "type": "checkbox", "id": "show_facts", "label": "Show shipping, how it's made and contact under the cover", "default": false }
  ],
  "presets": [{ "name": "Cover" }]
}
{% endschema %}
