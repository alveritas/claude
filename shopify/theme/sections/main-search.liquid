<section class="shell page-pad">
  <h1 class="page-title page-title-gap">Search</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page-form">
    <input type="hidden" name="type" value="product">
    <label for="search-page" class="sr-only">Search</label>
    <input id="search-page" class="field" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search">
    <button type="submit" class="btn btn-solid">Search</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="label search-count">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p>
      <div class="grid grid--4 joints product-grid-list">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}
            <div class="grid-cell">{% render 'product-card', product: item %}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pages">
          {%- if paginate.previous -%}<a class="btn btn-line" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          <span class="muted small">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="btn btn-line" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</section>
{% schema %}
{ "name": "Search", "class": "section-search", "settings": [] }
{% endschema %}
