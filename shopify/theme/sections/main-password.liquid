<section class="password-page">
  <h1 class="password-heading"><span class="sr-only">{{ settings.brand_name | default: shop.name }}</span><span class="password-mark" aria-hidden="true"><span class="wipe"><span class="brand-mark brand-wordmark"></span></span></span></h1>
  <p class="hero-tagline">{{ section.settings.text | escape }}</p>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  <div class="password-signup">{% render 'newsletter-form', form_id: 'newsletter-password' %}</div>
  <details class="password-owner">
    <summary class="muted micro">Enter with password</summary>
    {%- form 'storefront_password', class: 'password-form' -%}
      {%- if form.errors -%}<p class="form-error" role="alert">That password isn’t right.</p>{%- endif -%}
      <label class="label" for="pw">Password</label>
      <div class="nl-row">
        <input class="field" id="pw" type="password" name="password" autocomplete="current-password">
        <button type="submit" class="btn btn-solid">Enter</button>
      </div>
    {%- endform -%}
  </details>
</section>
{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "An identity without explanation." }
  ]
}
{% endschema %}
