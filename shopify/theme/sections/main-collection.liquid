{%- assign live_types = collections.all.products | map: 'type' | uniq | sort -%}
{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign all_url = routes.all_products_collection_url
  # Women's pieces are tagged "Women"; /collections/all/women lists just those.
  assign has_women = false
  if collections.all.all_tags contains 'Women'
    assign has_women = true
  endif
  assign on_women = false
  if current_tags contains 'Women' or current_tags contains 'women'
    assign on_women = true
  endif
  assign on_all = false
  if collection.handle == 'all' and on_women == false
    assign on_all = true
  endif
-%}
<section class="shell page-pad" data-collection>
  <div class="collection-head">
    <h1 class="page-title">{% if on_women %}Women{% elsif collection.handle == 'all' %}All products{% else %}{{ collection.title }}{% endif %}</h1>
    <p class="muted collection-count">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</p>
  </div>
  {%- if collection.description != blank -%}<div class="muted rte collection-desc">{{ collection.description }}</div>{%- endif -%}

  <div class="toolbar">
  <nav class="tabs" aria-label="Categories">
    <a class="tab{% if on_all %} is-active{% endif %}" href="{{ all_url }}"{% if on_all %} aria-current="page"{% endif %}>All</a>
    {%- if has_women -%}
      <a class="tab{% if on_women %} is-active{% endif %}" href="{{ all_url }}/women"{% if on_women %} aria-current="page"{% endif %}>Women</a>
    {%- endif -%}
    {%- for type in live_types -%}
      {%- if type != blank -%}
        {%- assign on_type = false -%}{%- if collection.title == type and collection.handle == 'types' -%}{%- assign on_type = true -%}{%- endif -%}
        <a class="tab{% if on_type %} is-active{% endif %}" href="{{ type | url_for_type }}"{% if on_type %} aria-current="page"{% endif %}>{{ type }}</a>
      {%- endif -%}
    {%- endfor -%}
  </nav>
    <form class="sort" method="get">
      {%- if collection.handle == 'types' and collection.title != blank -%}<input type="hidden" name="q" value="{{ collection.title | escape }}">{%- endif -%}
      <label for="sort-by" class="label">Sort</label>
      <select id="sort-by" name="sort_by" class="select" data-autosubmit>
        {%- for option in collection.sort_options -%}
          {%- if option.value contains 'relevan' or option.name == 'Most relevant' -%}{%- continue -%}{%- endif -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
      <noscript><button type="submit" class="btn btn-line">Apply</button></noscript>
    </form>
  </div>

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      {%- liquid
        # Four to a row on larger screens, two on phones; an odd count opens with one wide card on phones.
        assign odd = collection.products.size | modulo: 2
      -%}
      <div class="grid grid--4 product-grid-list">
        {%- for product in collection.products -%}
          {%- liquid
            assign cls = ''
            assign card_sizes = '(min-width: 1024px) 25vw, 50vw'
            if forloop.first and odd == 1
              assign cls = 'span-mobile'
              assign card_sizes = '(min-width: 1024px) 25vw, 100vw'
            endif
            assign eager = false
            if forloop.index <= 4
              assign eager = true
            endif
          -%}
          <div class="grid-cell {{ cls }}">{% render 'product-card', product: product, eager: eager, index: forloop.index0, heading: 'h2', sizes: card_sizes %}</div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted empty">Nothing here yet. <a class="text-link" href="{{ all_url }}">See every piece</a></p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pages">
        {%- if paginate.previous -%}<a class="btn btn-line" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span class="muted small">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="btn btn-line" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Collection", "class": "section-main-collection", "settings": [] }
{% endschema %}
