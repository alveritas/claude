{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign all_url = routes.all_products_collection_url
  # Men and Women are collections of their own (/collections/men, /collections/women); All is /collections/all.
  assign men_c = collections['men']
  assign women_c = collections['women']
  assign has_men = false
  assign has_women = false
  if men_c != blank and men_c.products_count > 0
    assign has_men = true
  endif
  if women_c != blank and women_c.products_count > 0
    assign has_women = true
  endif
  assign on_men = false
  assign on_women = false
  if collection.handle == 'men'
    assign on_men = true
  elsif collection.handle == 'women'
    assign on_women = true
  endif
  assign on_all = false
  if collection.handle == 'all'
    assign on_all = true
  endif
  # Inside Men or Women, the categories are only that section's own (e.g. /collections/men/tops).
  assign g = ''
  if on_men
    assign g = 'Men'
  elsif on_women
    assign g = 'Women'
  endif
  assign g_types = ''
  assign on_type = ''
  if g != blank
    capture g_csv
      render 'gender-types', tag: g
    endcapture
    assign g_types = g_csv | strip | split: ','
    for t in g_types
      assign t_handle = t | handle
      if current_tags contains t or current_tags contains t_handle
        assign on_type = t
      endif
    endfor
    assign g_url = collection.url
  endif
  assign page_heading = collection.title
  if g != blank
    assign page_heading = collection.title
    if on_type != blank
      assign page_heading = g | append: '’s ' | append: on_type | downcase | capitalize
    endif
  elsif collection.handle == 'all'
    assign page_heading = 'All products'
  endif
-%}
<section class="shell page-pad" data-collection>
  <div class="collection-head">
    <h1 class="page-title">{{ page_heading }}</h1>
    <p class="muted collection-count">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</p>
  </div>
  {%- if collection.description != blank -%}<div class="muted rte collection-desc">{{ collection.description }}</div>{%- endif -%}

  <div class="toolbar">
  <div class="tab-rows">
    <nav class="tabs" aria-label="Sections">
      <a class="tab{% if on_all %} is-active{% endif %}" href="{{ all_url }}"{% if on_all %} aria-current="page"{% endif %}>All</a>
      {%- if has_men -%}
        <a class="tab{% if on_men %} is-active{% endif %}" href="{{ men_c.url }}"{% if on_men %} aria-current="page"{% endif %}>Men</a>
      {%- endif -%}
      {%- if has_women -%}
        <a class="tab{% if on_women %} is-active{% endif %}" href="{{ women_c.url }}"{% if on_women %} aria-current="page"{% endif %}>Women</a>
      {%- endif -%}
    </nav>
    {%- if g != blank and g_types.size > 1 -%}
      <nav class="chips" aria-label="{{ g }}’s categories">
        <a class="chip{% if on_type == blank %} is-active{% endif %}" href="{{ g_url }}"{% if on_type == blank %} aria-current="page"{% endif %}>All {{ g | downcase }}’s</a>
        {%- for t in g_types -%}
          <a class="chip{% if on_type == t %} is-active{% endif %}" href="{{ g_url }}/{{ t | handle }}"{% if on_type == t %} aria-current="page"{% endif %}>{{ t }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
    <form class="sort" method="get">
      {%- if collection.handle == 'types' and collection.title != blank -%}<input type="hidden" name="q" value="{{ collection.title | escape }}">{%- endif -%}
      <label for="sort-by" class="label">Sort</label>
      <select id="sort-by" name="sort_by" class="select" data-autosubmit>
        {%- for option in collection.sort_options -%}
          {%- if option.value contains 'relevan' or option.name == 'Most relevant' -%}{%- continue -%}{%- endif -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
      <noscript><button type="submit" class="btn btn-line">Apply</button></noscript>
    </form>
  </div>

  {%- comment -%}
    All products, in its own order (no sort chosen): Men's pieces, then Women's, each in its section's
    own order, where every top sits beside a bottom it goes with. Anything in neither section follows.
  {%- endcomment -%}
  {%- liquid
    assign grouped = false
    if on_all and collection.sort_by == blank and has_men and has_women and collection.products_count <= 48
      assign grouped = true
    endif
  -%}
  {%- if grouped -%}
    {%- assign group_handles = 'men,women' | split: ',' -%}
    {%- assign shown = 0 -%}
    {%- for gh in group_handles -%}
      {%- assign gc = collections[gh] -%}
      <section class="group" aria-labelledby="group-{{ gh }}">
        <div class="group-head">
          <h2 id="group-{{ gh }}" class="group-title">{{ gc.title }}</h2>
          <a class="text-link section-link" href="{{ gc.url }}">Shop all {{ gc.title | downcase }}’s</a>
        </div>
        <div class="grid grid--4 product-grid-list">
          {%- for product in gc.products -%}
            {%- liquid
              assign eager = false
              if shown < 4
                assign eager = true
              endif
            -%}
            <div class="grid-cell">{% render 'product-card', product: product, eager: eager, index: forloop.index0, heading: 'h3' %}</div>
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endfor -%}
    {%- liquid
      assign others = 0
      for product in collection.products
        unless product.tags contains 'Men' or product.tags contains 'Women'
          assign others = others | plus: 1
        endunless
      endfor
    -%}
    {%- if others > 0 -%}
      <section class="group" aria-labelledby="group-more">
        <div class="group-head"><h2 id="group-more" class="group-title">More</h2></div>
        <div class="grid grid--4 product-grid-list">
          {%- for product in collection.products -%}
            {%- if product.tags contains 'Men' or product.tags contains 'Women' -%}{%- continue -%}{%- endif -%}
            <div class="grid-cell">{% render 'product-card', product: product, index: forloop.index0, heading: 'h3' %}</div>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- else -%}
  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      {%- liquid
        # Four to a row on larger screens, two on phones; an odd count opens with one wide card on phones.
        assign odd = collection.products.size | modulo: 2
      -%}
      <div class="grid grid--4 product-grid-list">
        {%- for product in collection.products -%}
          {%- liquid
            assign cls = ''
            assign card_sizes = '(min-width: 1024px) 25vw, 50vw'
            if forloop.first and odd == 1
              assign cls = 'span-mobile'
              assign card_sizes = '(min-width: 1024px) 25vw, 100vw'
            endif
            assign eager = false
            if forloop.index <= 4
              assign eager = true
            endif
          -%}
          <div class="grid-cell {{ cls }}">{% render 'product-card', product: product, eager: eager, index: forloop.index0, heading: 'h2', sizes: card_sizes %}</div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted empty">Nothing here yet. <a class="text-link" href="{{ all_url }}">See every piece</a></p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pages">
        {%- if paginate.previous -%}<a class="btn btn-line" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span class="muted small">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="btn btn-line" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Collection", "class": "section-main-collection", "settings": [] }
{% endschema %}
