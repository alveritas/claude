{%- liquid
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign all_url = routes.all_products_collection_url
  # Men's and women's pieces are tagged "Men" and "Women"; /collections/all/men and /women list just those.
  assign has_men = false
  if collections.all.all_tags contains 'Men'
    assign has_men = true
  endif
  assign on_men = false
  if current_tags contains 'Men' or current_tags contains 'men'
    assign on_men = true
  endif
  assign has_women = false
  if collections.all.all_tags contains 'Women'
    assign has_women = true
  endif
  assign on_women = false
  if current_tags contains 'Women' or current_tags contains 'women'
    assign on_women = true
  endif
  assign on_all = false
  if collection.handle == 'all' and on_women == false and on_men == false
    assign on_all = true
  endif
  # Inside Men or Women, the categories are only that section's own (e.g. /collections/all/men+tops).
  assign g = ''
  if on_men
    assign g = 'Men'
  elsif on_women
    assign g = 'Women'
  endif
  assign g_types = ''
  assign on_type = ''
  if g != blank
    capture g_csv
      render 'gender-types', tag: g
    endcapture
    assign g_types = g_csv | strip | split: ','
    for t in g_types
      assign t_handle = t | handle
      if current_tags contains t or current_tags contains t_handle
        assign on_type = t
      endif
    endfor
    assign g_handle = g | downcase
    assign g_url = all_url | append: '/' | append: g_handle
  endif
  assign page_heading = collection.title
  if g != blank
    assign page_heading = g
    if on_type != blank
      assign page_heading = g | append: '’s ' | append: on_type | downcase | capitalize
    endif
  elsif collection.handle == 'all'
    assign page_heading = 'All products'
  endif
-%}
<section class="shell page-pad" data-collection>
  <div class="collection-head">
    <h1 class="page-title">{{ page_heading }}</h1>
    <p class="muted collection-count">{{ collection.products_count }} {% if collection.products_count == 1 %}piece{% else %}pieces{% endif %}</p>
  </div>
  {%- if collection.description != blank -%}<div class="muted rte collection-desc">{{ collection.description }}</div>{%- endif -%}

  <div class="toolbar">
  <div class="tab-rows">
    <nav class="tabs" aria-label="Sections">
      <a class="tab{% if on_all %} is-active{% endif %}" href="{{ all_url }}"{% if on_all %} aria-current="page"{% endif %}>All</a>
      {%- if has_men -%}
        <a class="tab{% if on_men %} is-active{% endif %}" href="{{ all_url }}/men"{% if on_men %} aria-current="page"{% endif %}>Men</a>
      {%- endif -%}
      {%- if has_women -%}
        <a class="tab{% if on_women %} is-active{% endif %}" href="{{ all_url }}/women"{% if on_women %} aria-current="page"{% endif %}>Women</a>
      {%- endif -%}
    </nav>
    {%- if g != blank and g_types.size > 1 -%}
      <nav class="chips" aria-label="{{ g }}’s categories">
        <a class="chip{% if on_type == blank %} is-active{% endif %}" href="{{ g_url }}"{% if on_type == blank %} aria-current="page"{% endif %}>All {{ g | downcase }}’s</a>
        {%- for t in g_types -%}
          <a class="chip{% if on_type == t %} is-active{% endif %}" href="{{ g_url }}+{{ t | handle }}"{% if on_type == t %} aria-current="page"{% endif %}>{{ t }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
    <form class="sort" method="get">
      {%- if collection.handle == 'types' and collection.title != blank -%}<input type="hidden" name="q" value="{{ collection.title | escape }}">{%- endif -%}
      <label for="sort-by" class="label">Sort</label>
      <select id="sort-by" name="sort_by" class="select" data-autosubmit>
        {%- for option in collection.sort_options -%}
          {%- if option.value contains 'relevan' or option.name == 'Most relevant' -%}{%- continue -%}{%- endif -%}
          <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
      <noscript><button type="submit" class="btn btn-line">Apply</button></noscript>
    </form>
  </div>

  {%- paginate collection.products by 24 -%}
    {%- if collection.products.size > 0 -%}
      {%- liquid
        # Four to a row on larger screens, two on phones; an odd count opens with one wide card on phones.
        assign odd = collection.products.size | modulo: 2
      -%}
      <div class="grid grid--4 product-grid-list">
        {%- for product in collection.products -%}
          {%- liquid
            assign cls = ''
            assign card_sizes = '(min-width: 1024px) 25vw, 50vw'
            if forloop.first and odd == 1
              assign cls = 'span-mobile'
              assign card_sizes = '(min-width: 1024px) 25vw, 100vw'
            endif
            assign eager = false
            if forloop.index <= 4
              assign eager = true
            endif
          -%}
          <div class="grid-cell {{ cls }}">{% render 'product-card', product: product, eager: eager, index: forloop.index0, heading: 'h2', sizes: card_sizes %}</div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted empty">Nothing here yet. <a class="text-link" href="{{ all_url }}">See every piece</a></p>
    {%- endif -%}
    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="Pages">
        {%- if paginate.previous -%}<a class="btn btn-line" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        <span class="muted small">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
        {%- if paginate.next -%}<a class="btn btn-line" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "Collection", "class": "section-main-collection", "settings": [] }
{% endschema %}
