<section class="shell page-pad">
  <h1 class="page-title page-title-gap">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <a class="cat-tile" href="{{ article.url }}">
          {%- if article.image -%}<span class="frame cat-frame">{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', sizes: '(min-width: 1024px) 33vw, 100vw', widths: '400, 600, 900', alt: article.image.alt, class: 'cat-img' }}</span>{%- endif -%}
          <span class="cat-label"><span class="card-title">{{ article.title }}</span><span class="muted small">{{ article.published_at | date: '%B %-d, %Y' }}</span></span>
        </a>
      {%- else -%}
        <p class="muted">No posts yet.</p>
      {%- endfor -%}
    </div>
  {%- endpaginate -%}
</section>
{% schema %}
{ "name": "Blog", "class": "section-blog", "settings": [] }
{% endschema %}
