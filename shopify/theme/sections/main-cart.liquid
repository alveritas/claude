<section class="shell page-pad" data-cart-page>
  <h1 class="page-title page-title-gap">Bag</h1>
  {%- if cart.item_count > 0 -%}
    <div class="cart-page">
      <div class="cart-page-lines">{% render 'cart-lines' %}</div>
      <aside class="cart-page-aside" aria-label="Order summary">
        <div class="panel">
          {% render 'shipping-progress' %}
          {% render 'cart-summary' %}
          {%- if additional_checkout_buttons -%}
            <div class="extra-checkout">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </aside>
    </div>
  {%- else -%}
    <div class="empty-bag empty-bag--page">
      <p class="empty-title">Your bag is empty.</p>
      {% render 'bag-suggestions' %}
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-solid">Shop the drop</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{ "name": "Bag", "class": "section-main-cart", "settings": [] }
{% endschema %}
